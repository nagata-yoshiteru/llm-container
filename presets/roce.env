# =============================================================================
# b12x RoCEnante one-shot RoCE all-reduce を有効にする
#
#   TP2 の all-reduce を NCCL から RDMA の one-shot 実装に差し替える。
#   上流の実測 (2026-09-18 / healthy fleet): aggregate +5〜18% (C1-C6)。
#   単発 decode はほぼ変化なし。
#
# **先に patches/roce/ にランタイム本体を揃えること** (2 台とも):
#   SRC_IMAGE=vllm-dsv41:exl3b-roce ./scripts/build-roce-bundle.sh
#
#   揃っていなければ entrypoint が理由を print して自動で OFF にする
#   (NCCL のまま起動するので壊れはしない)。
#   詳細と安全装置: patches/roce/README.md
#
# 使い方 (2 台とも同じ --env-file を重ねる / worker -> head の順):
#
#   ssh -t <worker の管理 IP> 'cd ~/repos/llm-container && sudo docker compose \
#     --env-file .env --env-file presets/roce.env --profile worker up -d'
#
#   sudo docker compose --env-file .env --env-file presets/roce.env --profile head up -d
#
# 起動後に **両 rank のログで `RoCEnante all-reduce is live` を確認する**。
# 出ていなければ NCCL にフォールバックしている。
# =============================================================================

ROCE=1
