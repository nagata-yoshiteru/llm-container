# =============================================================================
# 256K コンテキスト / plain fp8 KV  -- plain fp8 での実用上限
#
#   sudo docker compose --env-file .env --env-file presets/256k.env --profile head up -d
#
# 128k.env との差分は MAX_MODEL_LEN の 1 行だけ。
#
# KV の確保量 (18GiB) は 128k.env と同じ = メモリ使用量は完全に同一。
# 18GiB で 286,458 token 取れているので、262,144 に対して 1.09 倍の余裕がある。
# つまり 128K が動いているなら 256K も追加コストなしで動くはず。
#
# 余裕が薄いのが不安なら 20GiB (21474836480) にすると 1.21 倍になるが、
# メモリ合計が 113GiB になり危険側に寄る。まずはこのままで。
# =============================================================================
MAX_MODEL_LEN=262144
MAX_NUM_BATCHED_TOKENS=8192
VLLM_KV_ARGS=--kv-cache-dtype fp8 --kv-cache-memory-bytes 19327352832 --block-size 256
