# =============================================================================
# Vision-Exp / anemll ランタイム + MiaAI-Lab hotfix — 1M / 同時実行 6
#
#   ★ Vision-Exp を GB10 で動かせる唯一の構成 (2026-09-06 時点)。
#
#   上流イメージ (.env の既定) は FlashInfer の SM120 sparse-MLA dual-cache
#   prefill が無くて起動できない。README の「⛔ 現状ブロック中」を参照。
#   こちらは **b12x compressed-MLA + nvfp4_ds_mla** を使うのでその経路を通らず、
#   vision は patches/hotfix-dsv4-vision-exp.py をランタイムに当てて有効化する。
#
#   出所: https://github.com/MiaAI-Lab/DeepSeek-v4-Flash-DSpark-2x-DGX-Spark
#   向こうのランチャー一式は使わず、**設定と patches/ だけ**この repo の作法
#   (compose の profile + scripts/entrypoint.sh) に載せ替えてある。
#
#   使い方 (worker と head で同じ組み合わせにすること):
#     sudo docker compose --env-file .env --env-file presets/anemll-vision-1m.env \
#       --profile head up -d
#
#   ★ イメージを跨ぐので、切り替え時は必ず vllm-cache を消すこと:
#     sudo rm -rf vllm-cache/{vllm,triton,torchinductor}/*
#
#   ⚠ vision の品質には既知の欠落がある (双方向 attention / bias_vl)。
#     README の「コミュニティ移植版という選択肢」を読んでから使うこと。
# =============================================================================

# -----------------------------------------------------------------------------
# イメージ (digest 固定 / linux-arm64 / vLLM 0.25 系 + b12x)
#   0731 用の presets/anemll-1m.env と同じイメージ。vision 対応は
#   イメージ側ではなく patches/ の hotfix で入れる。
# -----------------------------------------------------------------------------
VLLM_IMAGE=ghcr.io/anemll/dspark-vllm-gx10:0.1.1@sha256:a83948492cf13df455170fb42885f5ef4db54fefe0feff0f841ecbff464ac9d8

# -----------------------------------------------------------------------------
# hotfix (これが無いと vision が有効にならない)
#   entrypoint が patches/ を /opt/dspark-patches から順番に当てる。
#   fail-closed。1 つでも失敗したら起動しない。
# -----------------------------------------------------------------------------
DSPARK_APPLY_HOTFIXES=1
DSPARK_ENCODING_INSTALL=1
DSPARK_ENCODING_FILE=/models/DeepSeek-V4-Flash-Vision-Exp/encoding/encoding_dsv4.py

# -----------------------------------------------------------------------------
# コンテキスト / メモリ
#   nvfp4_ds_mla は 1 token あたりが fp8 の半分以下なので、1M でも 6 本入る。
#   上流報告: KV 2.33M tokens / max_concurrency 2.22 @ gmu 0.835。
#   ★ 例によって起動後に /metrics で実測すること。
# -----------------------------------------------------------------------------
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=6
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.85

# -----------------------------------------------------------------------------
# vLLM 引数
#
#   DSpark k=6 : Vision-Exp の drafter は n_predict=3 なので **5 以上かつ 3 の倍数**。
#                5 は 3 の倍数でないので 6 になる。0731 (anemll) の 5 とは違う。
#   cudagraph 48 : max_num_seqs*(k+1) = 6*7 = 42 を 8 の倍数に切り上げた値。
#                  k か MAX_NUM_SEQS を変えたらここも合わせること。
#   --limit-mm-per-prompt : 1 リクエストあたりの画像枚数。起動時の mm profiling が
#                           メモリ不足で落ちたら減らす。
#   --reasoning-config : 上流イメージ用 (.env) は空文字だが、こちらは実際に
#                        <think></think> を使う。イメージで違うので注意。
# -----------------------------------------------------------------------------
VLLM_PARSER_ARGS=--reasoning-parser deepseek_v4 --tool-call-parser deepseek_v4 --enable-auto-tool-choice --tokenizer-mode deepseek_v4 --reasoning-config {"reasoning_parser":"deepseek_v4","reasoning_start_str":"<think>","reasoning_end_str":"</think>"}

VLLM_KV_ARGS=--kv-cache-dtype nvfp4_ds_mla --block-size 256

VLLM_EXTRA_ARGS=--enable-prefix-caching --enable-chunked-prefill --long-prefill-token-threshold 1024 --async-scheduling --enable-prompt-tokens-details --generation-config vllm --enable-flashinfer-autotune --moe-backend flashinfer_b12x --max-cudagraph-capture-size 48 --speculative-config {"method":"dspark","num_speculative_tokens":6,"draft_sample_method":"probabilistic"} --limit-mm-per-prompt {"image":8} --default-chat-template-kwargs {"thinking":true,"reasoning_effort":"low"}

# -----------------------------------------------------------------------------
# b12x / NVFP4 DS-MLA
#   VLLM_USE_B12X_MOE=1 が速度の本体。0 にすると DeepGEMM MXFP4 経路に落ちて
#   decode が 29 tok/s 程度まで下がると上流が報告している。
# -----------------------------------------------------------------------------
VLLM_USE_B12X_MOE=1
VLLM_USE_B12X_WO_PROJECTION=1
VLLM_B12X_W4A16_FORCE_BLOCKS_PER_SM=0
VLLM_B12X_W4A16_FORCE_BLOCKS_MAX_M=16
VLLM_USE_FLASHINFER_SAMPLER=1
VLLM_USE_BREAKABLE_CUDAGRAPH=0
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0

# 既定イメージ (DeepGEMM FP8) 用の契約はこのイメージでは使わない。
# 空にすると entrypoint が unset する。
VLLM_USE_DEEP_GEMM_E8M0=
VLLM_MOE_USE_DEEP_GEMM=

# このイメージの NCCL は既定の解決に任せる。
VLLM_NCCL_SO_PATH=

CUTE_DSL_ARCH=sm_121a
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a
FLASHINFER_DISABLE_VERSION_CHECK=1
TILELANG_CLEANUP_TEMP_FILES=1
DG_JIT_USE_NVRTC=0
DG_JIT_NVCC_COMPILER=/usr/local/cuda/bin/nvcc

# JIT キャッシュは compose が vllm-cache/ 配下に振ってある (既定値のまま)。
# FlashInfer だけ HF キャッシュ側のマウントに置く。
FLASHINFER_WORKSPACE_BASE=/cache/huggingface/flashinfer

# HPC-X はこのイメージに無い。
VLLM_LD_LIBRARY_PATH_EXTRA=/usr/local/cuda/lib64

# -----------------------------------------------------------------------------
# NCCL (dual-HCA は .env 側で設定済み。ここはイメージ固有の上乗せだけ)
# -----------------------------------------------------------------------------
NCCL_NET=IB
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_CUMEM_ENABLE=0
