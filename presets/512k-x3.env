# =============================================================================
# 512K コンテキスト / 同時実行 3  — ★未検証・KV は「フル 3 本」には足りない
#
#   ## 先に結論
#
#   **512K を 3 本フルに使うのは、このハードでは無理。** KV が足りない。
#
#   0731 の実測から 1 token あたりの KV バイト数を逆算すると:
#     131,072 tok / 18GiB / 286,458 slots -> 67,470 B/token
#     262,144 tok / 18GiB / 539,285 slots -> 35,839 B/token
#   1,048,576 tok / 20GiB / 1,772,550 slots -> 12,115 B/token
#   (c4/c128 圧縮と 128 token sliding window が効くので、長いほど 1 token が安い)
#
#   512K はこの間で **約 20,800 B/token** と推定される。フル 512K を 3 本なら
#   1,572,864 slots 必要で、これは **KV 約 30.5GiB**。
#
#   一方このハードの上限は:
#     unified 121GiB - 重み 78.2GiB - ランタイム 15GiB = **27.8GiB** (KV + 活性化)
#   30.5GiB は物理的に入らない。しかも活性化メモリの分を残す必要がある。
#
#   KV 20GiB のままだと slots は約 1,030,000。つまり:
#     - フル 512K なら **1.97 本**
#     - 3 本同時に動かすなら **1 本あたり平均 343K まで**
#
#   ## それでもこのプリセットが有用な場合
#
#   vLLM の max_concurrency は「MAX_MODEL_LEN いっぱいのリクエストが何本入るか」で
#   あって、**MAX_NUM_SEQS=3 自体は問題なく設定できる**。3 本の合計が KV プールに
#   収まっている限り 3 本走るし、溢れたら vLLM が preempt して順番待ちにする。
#
#   「たまに 512K の長いのが来るが、普段は 100〜300K を数本」という使い方なら、
#   これが一番おいしい。**常時 3 本フル 512K を期待する用途には使えない。**
#
#   ## KV を増やすのは危険
#
#   KV を 24GiB に上げれば 2.36 本相当まで伸びるが、**天井は KV ではなく prefill の
#   活性化メモリ**。0731 実測で MemAvailable の最小値は 250K 入力で 6.7GiB、
#   900K 入力で 1.9GiB (いずれも KV 20GiB 時)。ここから 4GiB 削ると 500K の prefill で
#   OOM-kill (exit 137) に入る。**上げるなら 22GiB までにして、必ず長尺を投げて試すこと。**
#
#   ## 使い方 (worker と head で同じ組み合わせにすること)
#
#     sudo docker compose --env-file .env --env-file presets/512k-x3.env \
#       --profile head up -d
#
#   起動したら必ず実測すること。推定はこのリポジトリで 2 回外している
#   (presets/README.md の「KV サイズは計算で予測できない」参照):
#     curl -s http://127.0.0.1:8910/metrics | grep 'cache_config_info{' | tr ',' '\n' \
#       | grep -E 'kv_cache_max_concurrency|kv_cache_size_tokens'
# =============================================================================

MAX_MODEL_LEN=524288
MAX_NUM_SEQS=3

# 上げない。3 本ぶんの prefill 活性化が乗るので、むしろここが効いてくる。
# 長尺で OOM-kill されたら 4096 まで落とす。
MAX_NUM_BATCHED_TOKENS=8192

# KV は既定と同じ 20GiB。上のコメントのとおり、増やすと prefill 側が死ぬ。
VLLM_KV_ARGS=--kv-cache-dtype fp8 --kv-cache-memory-bytes 21474836480 --block-size 256

# -----------------------------------------------------------------------------
# 既定 (.env) との差分:
#   --enable-prefix-caching   : seqs>1 なら効く (既定は seqs=1 なので切っていた)
#   --enable-chunked-prefill  : 512K の prefill が他の 2 本を止めるのを防ぐ。
#                               seqs>1 で長尺を混ぜるならほぼ必須。
#   --long-prefill-token-threshold 1024 : 上の閾値
#   cudagraph_capture_sizes   : max_num_seqs x (k+1) = 3 x 4 = 12
#
#   --async-scheduling は入れていない (throughput-256k.env とは違う点)。
#   長尺 prefill と組み合わせた挙動が読めないので、まず素直な構成で通すこと。
# -----------------------------------------------------------------------------
VLLM_EXTRA_ARGS=--enable-prefix-caching --enable-chunked-prefill --long-prefill-token-threshold 1024 --moe-backend marlin --speculative-config {"method":"dspark","num_speculative_tokens":3,"draft_sample_method":"probabilistic","enable_adaptive_verification":true} --compilation-config {"cudagraph_mode":"FULL_DECODE_ONLY","cudagraph_capture_sizes":[12],"cudagraph_num_of_warmups":2}
