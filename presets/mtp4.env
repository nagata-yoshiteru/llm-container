# =============================================================================
# MTP-4 に戻す (DFlash2 を使わない構成)
#
#   既定は DFlash2 (decode 約 46.9 t/s)。この preset は checkpoint 同梱の
#   MTP head を使う旧構成 (約 21.8 t/s) に戻す。
#
# 使う理由:
#   - DFlash2 drafter のライセンスが CC-BY-NC-ND-4.0 (非商用・改変禁止) なので、
#     商用利用では使えない
#   - drafter (2.2GB) を落としたくない / 切り分けのため speculation を単純にしたい
#
# 使い方 (2 台とも同じ --env-file を重ねる / worker -> head の順):
#
#   ssh -t <worker の管理 IP> 'cd ~/repos/llm-container && sudo docker compose \
#     --env-file .env --env-file presets/mtp4.env --profile worker up -d'
#
#   sudo docker compose --env-file .env --env-file presets/mtp4.env --profile head up -d
#
# **イメージが変わるので JIT キャッシュを 2 台で消すこと**:
#   sudo rm -rf vllm-cache/{vllm,triton,torchinductor,flashinfer,tilelang}/*
# =============================================================================

# v8 (DFlash2 overlay なし / digest 固定 / linux-arm64)
# タグ表記では ghcr.io/tonyd2wild/vllm-glm53-flash:sm121-v8
VLLM_IMAGE=ghcr.io/tonyd2wild/vllm-glm53-flash@sha256:d77d375c742fc54f436dec5108b440f58f021bc6600052bf0e8fe5840357e78f

# MTP head は checkpoint 同梱 (model_mtp.safetensors / 約 7.6GB)。
# num_speculative_tokens=4 が上流の検証値。
VLLM_EXTRA_ARGS=--moe-backend marlin --enforce-eager --speculative-config {"method":"mtp","num_speculative_tokens":4}

# KV プールの固定は解除する。
#
# 8 GiB 固定は **DFlash2 構成でしか測られていない**。DFlash2 の drafter は MLA
# テンソルに slot-share するので KV 追加コストがほぼ 0 だが、MTP head は
# 約 4GB/rank を別に食う。この組み合わせで 8 GiB を固定した実測が無いので、
# ここではプロファイラに任せる (fp8 KV で約 50 万トークン / 262K ctx)。
KV_CACHE_MEMORY=0

# prefix-cache 修正 (#18) は DFlash2 の draft group 問題に対するものなので、
# MTP 構成では当てない (v8 イメージには当てる対象の前提も無い)。
PREFIX_FIX=0
