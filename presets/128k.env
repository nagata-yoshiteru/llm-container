# =============================================================================
# 128K コンテキスト / plain fp8 KV  -- 実績のある構成
#
#   sudo docker compose --env-file .env --env-file presets/128k.env --profile head up -d
#
# .env.example の既定と同じ値なので、128K で使うならプリセット指定は不要
# (プリセットなし = この内容)。他から戻すときの基準として置いてある。
#
# 実測: 18GiB -> 286,458 token (必要量 131,072 の 2.19 倍。かなり余裕がある)
#       生成 42 tok/s、メモリ合計 111GiB / 121GiB
# =============================================================================
MAX_MODEL_LEN=131072
MAX_NUM_BATCHED_TOKENS=8192
VLLM_KV_ARGS=--kv-cache-dtype fp8 --kv-cache-memory-bytes 19327352832 --block-size 256
