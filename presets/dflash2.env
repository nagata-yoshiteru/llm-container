# =============================================================================
# GLM-5.3-Flash-NVFP4 / DFlash2 speculative decoding 構成 (高速版)
#
#   .env (MTP-4 / decode 約 21.8 t/s) の代わりに DFlash2 (約 46.9 t/s) を使う。
#   上流が「推奨」として載せている組み合わせ。 drafter の KV 追加コストはほぼ 0
#   (MLA テンソルに slot-share)。 2.15x の単一ストリーム decode 向上。
#
# 使い方 (2 台とも同じ --env-file を重ねる / worker -> head の順):
#
#   ssh -t 192.168.118.14 'cd ~/repos/llm-container && sudo docker compose \
#     --env-file .env --env-file presets/dflash2.env --profile worker up -d'
#
#   sudo docker compose --env-file .env --env-file presets/dflash2.env \
#     --profile head up -d
#
# 追加で必要なもの:
#   1. drafter を 2 台の DRAFT_PATH に取得:  ./scripts/fetch-model.sh draft
#      (incoai/GLM-5.3-Flash-DFlash2 / 約 2.2GB / ライセンス CC-BY-NC-ND-4.0 非商用)
#   2. イメージを差し替えるので vllm-cache/{vllm,triton,torchinductor} を消すこと:
#         sudo rm -rf vllm-cache/{vllm,triton,torchinductor}/*
#
# MTP-4 に戻すなら --env-file presets/dflash2.env を外すだけ。
# =============================================================================

# DFlash2 対応イメージ (v8 + DFlash2 overlay / digest 固定 / linux-arm64)
VLLM_IMAGE=ghcr.io/tonyd2wild/vllm-glm53-flash@sha256:4def0ef644cb2e9814136dcffd5e385e21bc594f48f3b292234051904abe85a6

# drafter は DRAFT_PATH がコンテナ内で /models/GLM-5.3-Flash-DFlash2 にマウントされる。
# num_speculative_tokens=7 は drafter の block_size 8 - 1 で固定。
# 8 にするとモデルが学習していない位置を draft するので 7 のままにすること。
VLLM_EXTRA_ARGS=--moe-backend marlin --enforce-eager --speculative-config {"method":"dflash","model":"/models/GLM-5.3-Flash-DFlash2","num_speculative_tokens":7}
