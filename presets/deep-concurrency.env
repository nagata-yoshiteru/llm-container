# =============================================================================
# 並行リクエストが多い運用向けの speculative depth
#
#   既定は k=7 固定。単発ストリームには最速だが、並行度が上がると draft の
#   検証コストが勝ってしまう。上流の実測 (2026-09-02 / TP2):
#
#     k=5 vs k=7 : C4 +29.9% / C6 +18.3%、ただし単発は全プロンプトで -15〜-24%
#
#   ここでは C4 を境にした schedule を使い、単発は k=7、C4 以上は k=5 にする
#   (バッチサイズ 1〜3 -> 7 / 4〜512 -> 5)。
#
#   単純に k=5 固定にしたいなら num_speculative_tokens を 5 にして
#   num_speculative_tokens_per_batch_size を消す。
#
# 使い方 (2 台とも同じ --env-file を重ねる / worker -> head の順):
#
#   sudo docker compose --env-file .env --env-file presets/deep-concurrency.env \
#     --profile head up -d
#
# イメージは変わらないので JIT キャッシュを消す必要はない。
#
# なお MAX_NUM_SEQS を 6 から上げるのは別問題。上流が 32 を試して C12 で
# aggregate +10% しか出ず、C8〜C16 で TTFT p90 が 60〜179 秒に悪化した。
# さらに mnbt 16384 と併せると両ノードが NVRM OOM で死ぬ。6 のままにすること。
# =============================================================================

VLLM_EXTRA_ARGS=--moe-backend marlin --enforce-eager --speculative-config {"method":"dflash","model":"/models/GLM-5.3-Flash-DFlash2","num_speculative_tokens":7,"num_speculative_tokens_per_batch_size":[[1,3,7],[4,512,5]]}
