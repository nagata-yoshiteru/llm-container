# =============================================================================
# スループット重視 / 256K コンテキスト / 同時実行 6  — ★未検証
#
#   既定 (.env) は「1 本の長いリクエストを 1M まで通す」構成で、MAX_NUM_SEQS=1 /
#   prefix caching 無効。単発 decode は速いが、**同時に複数投げると全く伸びない**。
#
#   エージェント用途のように短〜中の会話を並列で回すなら、コンテキストを 256K に
#   落として同時実行を上げた方がトータルは大きい。上流 2 台 Spark の報告値:
#     単発      : 62〜85 tok/s
#     c6 合計   : 160〜197 tok/s   <- こちら側の world
#
#   使い方 (worker と head で同じ組み合わせにすること):
#     sudo docker compose --env-file .env --env-file presets/throughput-256k.env \
#       --profile head up -d
#
#   ★ このリポジトリでは未計測。上流の値は別イメージ (anemll / b12x 系) での
#     ものなので、そのまま出るとは限らない。起動したら /metrics で
#     max_concurrency を確認すること (>= 1.0 が条件)。
#
#   ★ フラグの互換性も未確認。--async-scheduling / --long-prefill-token-threshold は
#     上流イメージ (vLLM 0.29 系) に無い / 名前が違う可能性がある。起動時に
#     unrecognized で落ちたら、その行から順に削って切り分けること。
# =============================================================================

MAX_MODEL_LEN=262144

# 同時実行を上げる。KV を 6 本で分け合うので、コンテキストは 256K までに落とす。
MAX_NUM_SEQS=6

# 並列時は prefill が詰まりやすいので、1 バッチを大きめに取る。
MAX_NUM_BATCHED_TOKENS=16384

# KV は既定と同じ fp8 固定確保。256K x 6 本が入るかは /metrics で確認する。
VLLM_KV_ARGS=--kv-cache-dtype fp8 --kv-cache-memory-bytes 21474836480 --block-size 256

# -----------------------------------------------------------------------------
# 既定との差分:
#   --enable-prefix-caching      : seqs>1 なら効く (既定は seqs=1 なので切っていた)
#   --enable-chunked-prefill     : 長い prefill が他のリクエストを止めるのを防ぐ
#   --long-prefill-token-threshold 1024 : 上の閾値
#   --async-scheduling           : スケジューラを実行と重ねる
#   cudagraph_capture_sizes      : max_num_seqs x (k+1) = 6 x 4 = 24
#                                  (k=3 は .env と同じ。ここを変えるなら合わせること)
# -----------------------------------------------------------------------------
VLLM_EXTRA_ARGS=--enable-prefix-caching --enable-chunked-prefill --long-prefill-token-threshold 1024 --async-scheduling --moe-backend marlin --speculative-config {"method":"dspark","num_speculative_tokens":3,"draft_sample_method":"probabilistic","enable_adaptive_verification":false} --compilation-config {"cudagraph_mode":"FULL_DECODE_ONLY","cudagraph_capture_sizes":[24],"cudagraph_num_of_warmups":2}
