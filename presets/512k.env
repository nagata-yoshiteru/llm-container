# 512K — 実用上の上限。【未実測 / GPU_MEMORY_UTILIZATION の引き上げが必須】
#
#   KV プールは MAX_MODEL_LEN では決まらず、空きメモリの分だけ確保される。
#   既定の util では 512K に足りず max_concurrency が 1.0 を切って起動に失敗するため、
#   ここで util を上げる。ただし head の天井が 0.875 なのでほとんど余裕は無い。
#
#   起動後に必ず確認すること:
#     curl -s http://127.0.0.1:8910/metrics | grep 'cache_config_info{' | tr ',' '\n' \
#       | grep -E 'kv_cache_max_concurrency|kv_cache_size_tokens'
MAX_MODEL_LEN=524288
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=512
GPU_MEMORY_UTILIZATION=0.87
