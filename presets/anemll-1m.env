# =============================================================================
# anemll ランタイム / NVFP4 DS-MLA / b12x MoE / DSpark k=5  — 1M コンテキスト
#
#   ⚠ このプリセットは DeepSeek-V4-Flash-0731 専用。Vision-Exp では使えない。
#     VLLM_IMAGE を anemll 版 (vLLM 0.25 系ベース) に差し替えるプロファイルだが、
#     そこには Vision-Exp の視覚モジュール実装が入っていないため、text-only の
#     モデルクラスに解決されて vision のテンソルで落ちる。
#     Vision-Exp で使うなら、anemll 側が vision 対応イメージを出すのを待つこと。
#
#   これは「チューニング違い」ではなく **ランタイムイメージごと差し替える**
#   プロファイル。DevelopersIO の 2 ノード記事 (decode 71〜76 tok/s) と、その
#   出所である MiaAI-Lab のレシピに合わせてある。
#
#     https://dev.classmethod.jp/articles/dgx-spark-2node-deepseek-v4-flash-0731/
#     https://github.com/MiaAI-Lab/DeepSeek-v4-Flash-DSpark-2x-DGX-Spark
#     https://github.com/Anemll/dspark-vllm-gx10
#
#   既定 (bjk110 / vLLM 0.25.0) との差:
#     - KV: fp8 固定 20GiB      -> nvfp4_ds_mla (gpu-memory-utilization で確保)
#     - MoE: marlin             -> flashinfer_b12x (+ VLLM_USE_B12X_MOE=1)
#     - DSpark: k=7 greedy      -> k=5 probabilistic
#         0731 の drafter は 1 パス 5 トークン (dspark_block_size=5)。
#         k>5 は上流レシピでは boot 拒否 / 生成時 crash になる。
#     - cudagraph: 固定 [8]     -> --max-cudagraph-capture-size 36 (= seqs*(k+1))
#     - prefix caching 無効     -> 有効 + chunked prefill + async scheduling
#     - MAX_NUM_SEQS 1          -> 6
#
#   **重み・イメージとも 2 台に配ってから使うこと。**
#
#     sudo docker compose --env-file .env --env-file presets/anemll-1m.env \
#       --profile head up -d
#
#   未検証プロファイル。既定の bjk110 構成は .env のまま残っているので、
#   ダメなら --env-file を外すだけで戻せる。
# =============================================================================

# -----------------------------------------------------------------------------
# ランタイム (vLLM 0.25.2 / GB10 native DSpark + NVFP4 DS-MLA + b12x MoE)
#   sudo docker pull ghcr.io/anemll/dspark-vllm-gx10:0.1.1
# digest 固定にしたい場合は pull 後に
#   sudo docker inspect --format='{{index .RepoDigests 0}}' ghcr.io/anemll/dspark-vllm-gx10:0.1.1
# -----------------------------------------------------------------------------
VLLM_IMAGE=ghcr.io/anemll/dspark-vllm-gx10:0.1.1

# -----------------------------------------------------------------------------
# サービングプロファイル
#   KV バイト数は固定しない (nvfp4_ds_mla は 1 トークンあたりが半分以下になるので、
#   gpu-memory-utilization に任せて 200 万トークン級のプールを取らせる)。
#   graph capture OOM が出たら GPU_MEMORY_UTILIZATION を 0.78 まで下げる。
# -----------------------------------------------------------------------------
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=6
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.85

# 0731 は chat template を同梱せず encoding_dsv4.py が本体。
# entrypoint がこれをランタイムへ入れる (--tokenizer-mode deepseek_v4 とセット)。
DSPARK_ENCODING_INSTALL=1

VLLM_PARSER_ARGS=--reasoning-parser deepseek_v4 --tool-call-parser deepseek_v4 --enable-auto-tool-choice --tokenizer-mode deepseek_v4 --reasoning-config {"reasoning_parser":"deepseek_v4","reasoning_start_str":"<think>","reasoning_end_str":"</think>"}

VLLM_KV_ARGS=--kv-cache-dtype nvfp4_ds_mla --block-size 256

# --max-cudagraph-capture-size 36 = MAX_NUM_SEQS 6 * (k 5 + 1)。
#   MAX_NUM_SEQS / k を変えたらここも計算し直すこと。
# --default-chat-template-kwargs: 未指定だと thinking が出ない。off にしたいなら
#   {"thinking":false}、常時フル思考なら "reasoning_effort":"max"。
VLLM_EXTRA_ARGS=--enable-prefix-caching --enable-chunked-prefill --async-scheduling --enable-prompt-tokens-details --generation-config vllm --enable-flashinfer-autotune --moe-backend flashinfer_b12x --max-cudagraph-capture-size 36 --speculative-config {"method":"dspark","num_speculative_tokens":5,"draft_sample_method":"probabilistic"} --default-chat-template-kwargs {"thinking":true,"reasoning_effort":"low"}

# -----------------------------------------------------------------------------
# ランタイム env (anemll イメージで登録されているものだけ)
#   VLLM_DSPARK_* / VLLM_USE_B12X_WO_PROJECTION などの Stage-C 用キルスイッチは
#   このイメージには無い。付けても "Unknown vLLM environment variable" になるだけ。
# -----------------------------------------------------------------------------
VLLM_USE_B12X_MOE=1
VLLM_B12X_W4A16_FORCE_BLOCKS_PER_SM=0
VLLM_B12X_W4A16_FORCE_BLOCKS_MAX_M=16
VLLM_USE_FLASHINFER_SAMPLER=1
# 未設定だと anemll 側が遅い breakable graph 経路を自動で有効にする
VLLM_USE_BREAKABLE_CUDAGRAPH=0
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256
VLLM_MEMORY_PROFILER_ESTIMATE_CUDAGRAPHS=0

# DeepGEMM FP8 経路は bjk110 イメージ用。b12x MoE ではこちらを使わないので空にする
# (空文字は entrypoint が unset する)。
VLLM_USE_DEEP_GEMM_E8M0=
VLLM_MOE_USE_DEEP_GEMM=
# libnccl のパスもイメージで違う。イメージ側の解決に任せる。
VLLM_NCCL_SO_PATH=

CUTE_DSL_ARCH=sm_121a
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1a
FLASHINFER_DISABLE_VERSION_CHECK=1
FLASHINFER_WORKSPACE_BASE=/cache/huggingface/flashinfer
TILELANG_CLEANUP_TEMP_FILES=1
DG_JIT_USE_NVRTC=0
DG_JIT_NVCC_COMPILER=/usr/local/cuda/bin/nvcc

# LD_LIBRARY_PATH は entrypoint が「前に足す」。bjk110 用の HPC-X パスは
# このイメージには無いので CUDA だけにする。
VLLM_LD_LIBRARY_PATH_EXTRA=/usr/local/cuda/lib64

# -----------------------------------------------------------------------------
# NCCL (上流レシピが明示しているもの)
# -----------------------------------------------------------------------------
NCCL_NET=IB
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_CROSS_NIC=1
NCCL_CUMEM_ENABLE=0
