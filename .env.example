# =============================================================================
# GLM-5.3-Flash UNCENSORED / MLX 4bit / Mac Studio (M5 Ultra 256GB) / Rapid-MLX
#
#   cp .env.example .env
#
# docker compose 時代と同じ KEY=VALUE (クォートなし) の書式。scripts/env.sh が読む。
# 書いていないキーは scripts/env.sh の既定値になる (このファイルの値と同じ)。
# 相対パスは repo ルート基準。
# =============================================================================

# --- 重み -------------------------------------------------------------------
# dealignai の uncensored (FP8) を Solstice-AI が MLX 4bit (oQ4e) に変換したもの。
# NVFP4 版 (DGX 用) は CUDA 専用なので Mac では使えない。
# fetch-model.sh がここに取得する (約 186GB)。
MODEL_REPO=Solstice-AI/GLM-5.3-Flash-UNCENSORED-mlx-oQ4e-DFlash2
MODEL_REVISION=bff40d24efb689d33e094083ce4a5d6835601730
MODEL_PATH=./models/GLM-5.3-Flash-UNCENSORED-mlx-oQ4e

# chat template は Solstice 独自版 (独自 system prompt を常に注入) ではなく元の dealignai 版。
# fetch-model.sh が MODEL_PATH/upstream-dealignai/ に取得する。
TEMPLATE_REPO=dealignai/GLM-5.3-Flash-UNCENSORED-FP8
TEMPLATE_REVISION=d5822b068da8ddb301665b48c58718e6e18a2c3a

# 実際に serve するディレクトリ。prepare-model.sh が MODEL_PATH から作る
# (shard は hardlink。量子化キーの修正・混在ビットの再量子化・float32 復元・template 差し替え)。
# 空にすると MODEL_PATH の末尾に -mlxvlm を付けたパスになる。
SERVE_MODEL_PATH=./models/GLM-5.3-Flash-UNCENSORED-mlx-oQ4e-mlxvlm

# --- ランタイム ---------------------------------------------------------------
VENV_DIR=./venv
RAPID_MLX_VERSION=1.0.2
RUNTIME_DIR=./.cache/rapid-mlx

# --- API --------------------------------------------------------------------
SERVED_MODEL_NAME=glm-5.3-flash-uncensored
# LAN に出すなら API_HOST=0.0.0.0 と API_KEY を両方設定する
# (キーなしの公開バインドは rapid-mlx が拒否する)
API_HOST=127.0.0.1
HOST_PORT=8910
API_KEY=

# --- サービング ---------------------------------------------------------------
# モデル上限は 1048576。上げる前にメモリと TTFT を実測すること。
MAX_MODEL_LEN=262144
# vision 込みのモデルは rapid-mlx が直列に処理するので、実際の同時実行は 1
MAX_NUM_SEQS=4
PREFILL_STEP_SIZE=1024
# 空 = bf16。int8/int4 は MLA 系だと Rapid-MLX が拒否する可能性あり
KV_CACHE_DTYPE=
# 空 = 自動 (空き RAM の約 20%)
CACHE_MEMORY_MB=
# 0 = --no-spec-decode。uncensored 重み + MTP sidecar は未検証
SPEC_DECODE=0
# 空 = テンプレート既定 (Max)。none/minimal/low/medium/high/xhigh
# low は拒否が一部残る設計 (dealignai のモデルカード)
DEFAULT_REASONING_EFFORT=
TOOL_CALL_PARSER=glm47
REASONING_PARSER=glm5
RAPID_MLX_EXTRA_ARGS=

# --- メモリ -----------------------------------------------------------------
# sudo sysctl iogpu.wired_limit_mb=<これ>。再起動で戻るので毎回実行する。
# 240GiB (OS に 16GiB 残す)。macOS が固まるなら下げる。
WIRED_LIMIT_MB=245760
