# =============================================================================
# RedHatAI/GLM-5.3-Flash-NVFP4 / 2x DGX Spark (GB10) — 共通 .env
#
#   cp .env.example .env して、トポロジの値を自分の環境に合わせる。
#
# 2 台とも「同じ内容」を置く。役割は compose の --profile で切り替える。
# head と worker で相手を向いているポート名が違う場合は、worker 側は
# WORKER_ROCE_IF_NAME / WORKER_IB_HCA_NAME で差し替える (compose が見る)。
#
# `sudo docker compose` から読まれるので ${HOME} 等のシェル変数は使えない。
#
# -----------------------------------------------------------------------------
# 起動 (worker -> head の順)。
# 片方だけ違う --env-file 組み合わせで起動すると rendezvous で死ぬ。
#
#   ssh -t <worker の管理 IP> 'cd ~/repos/llm-container && sudo docker compose \
#     --profile worker up -d'
#
#   sudo docker compose --profile head up -d
#
# 既定は v8 イメージ + MTP-4 構成。DFlash2 は presets/dflash2.env を重ねる。
# =============================================================================

# イメージ (digest 固定 / linux-arm64 / day-0 公式 + SM121 パッチ 8 段)
# 素の vLLM では GB10 で glm5_next が起動しない (NoPE MLA の assert)。
VLLM_IMAGE=ghcr.io/tonyd2wild/vllm-glm53-flash@sha256:d77d375c742fc54f436dec5108b440f58f021bc6600052bf0e8fe5840357e78f

# モデル (2 台とも同じパス / 約 198GB・10 shard + model_mtp.safetensors)
#   ./scripts/fetch-model.sh がこのパスにダウンロードする
MODEL_PATH=./models/GLM-5.3-Flash-NVFP4
MODEL_CONTAINER_PATH=/models/GLM-5.3-Flash-NVFP4
SERVED_MODEL_NAME=glm-5.3-flash

# DFlash2 drafter の置き場所 (presets/dflash2.env だけ使う / 約 2.2GB)
#   ./scripts/fetch-model.sh draft で取得
DRAFT_PATH=./models/GLM-5.3-Flash-DFlash2

# -----------------------------------------------------------------------------
# トポロジ / ネットワーク
#
#   head と worker の QSFP (RoCE) 側 IP / IF 名 / HCA 名 / GID index を入れる。
#   確認方法:
#     ip -br addr show <IF>        # RoCE 側の IPv4
#     show_gids                    # その IPv4 が載る行の DEV / INDEX (RoCE v2 の方)
#   Spark は RoCE ポートを 2 本見せるがケーブルが刺さっているのは 1 本だけ。
#   刺さっていない側の GID index 3 は空なので、必ずケーブル側の HCA に固定する。
#   QSFP 側は link-local で再起動すると IP が変わることがある (preflight 検出)。
# -----------------------------------------------------------------------------
TP_SIZE=2
NNODES=2
MASTER_PORT=29501

HEAD_ROCE_IP=
WORKER_ROCE_IP=

ROCE_IF_NAME=
IB_HCA_NAME=
NCCL_IB_GID_INDEX=3

# worker 側だけ別ポートを向いている場合の上書き (未設定なら head と同じ値)
WORKER_ROCE_IF_NAME=
WORKER_IB_HCA_NAME=
WORKER_NCCL_IB_GID_INDEX=

# API ポート (OpenAI 互換)
HOST_PORT=8910

# -----------------------------------------------------------------------------
# コンテキスト / メモリ
#
#   TP2 で検証されているコンテキストは 262,144 (ネイティブ上限は 1M だが
#   TP2 の KV プールでは 1M 単一リクエストは載らない)。
#   --kv-cache-memory は固定しないこと (GB10 の MemFree 壁を参照 / README)。
#   MAX_NUM_BATCHED_TOKENS は空のままとする (vLLM のハイブリッド既定を使う)。
# -----------------------------------------------------------------------------
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=6
MAX_NUM_BATCHED_TOKENS=
GPU_MEMORY_UTILIZATION=0.88

# -----------------------------------------------------------------------------
# vLLM 引数 (JSON 値の中に空白を入れないこと)
# -----------------------------------------------------------------------------
VLLM_PARSER_ARGS=--tool-call-parser glm47 --enable-auto-tool-choice --reasoning-parser glm45
VLLM_KV_ARGS=--kv-cache-dtype fp8_e4m3 --block-size 2304
VLLM_EXTRA_ARGS=--moe-backend marlin --enforce-eager --speculative-config {"method":"mtp","num_speculative_tokens":4}

# -----------------------------------------------------------------------------
# SM121 数値契約 / NCCL (RoCEv2 固定)
#   NCCL_IB_ADDR_RANGE は RoCE サブネット (x.x.x.0/24) を入れる。
# -----------------------------------------------------------------------------
FLASHINFER_CUDA_ARCH_LIST=12.1a
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_DISABLE_VERSION_CHECK=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
VLLM_ENGINE_READY_TIMEOUT_S=3600

NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_IB_ADDR_RANGE=
NCCL_CROSS_NIC=0
NCCL_IB_MERGE_NICS=0
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_NVLS_ENABLE=0
NCCL_DEBUG=WARN
TORCH_NCCL_ASYNC_ERROR_HANDLING=1
MAX_JOBS=4
