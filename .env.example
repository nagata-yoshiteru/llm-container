# =============================================================================
# nvidia/Qwen3.8-Flash-Next-NVFP4
#   / 1 workstation + 2x RTX PRO 6000 Blackwell Max-Q (GB202 / SM120 / 96 GB)
#
#   cp .env.example .env して使う。1 台で完結するのでコピーは 1 個だけ。
#   `sudo docker compose` から読まれるので ${HOME} 等のシェル変数は使えない。
#
#   既定は 1M コンテキスト (static YaRN factor 4.0) + MTP 投機デコード k=3。
#
#   このファイルの既定値は「96 GB 級の SM120 カード 2 枚 / NVLink 無し」を
#   想定している。枚数や VRAM が違う機体では、下の各節の計算式に従って
#   TP_SIZE と GPU_MEMORY_UTILIZATION を読み替えること。
#   preflight.sh が実機の値を読んで計算し直してくれる。
# =============================================================================

# -----------------------------------------------------------------------------
# ★★ 起動前に必ず読むこと: この構成で踏みやすい 2 つの落とし穴 ★★
# -----------------------------------------------------------------------------
#
# (1) GPU が x16 未満のスロットに刺さっていないか
#
#     マザーによっては、2 本目以降の PCIe スロットが物理的には x16 の形でも
#     チップセット配下の x4 / x8 にしか配線されていないことがある。GPU 側が
#     Gen5 x16 対応でも、リンクは狭い方に合わせられる。
#
#     確認は GPU 自身ではなく**上流ブリッジの LnkCap** を見る
#     (GPU の max_link_width は「GPU が対応する最大」でスロット配線を反映しない):
#
#       $ for d in /sys/bus/pci/devices/*; do
#           [ -e "$d/max_link_width" ] || continue
#           echo "$(basename $d) $(cat $d/max_link_speed) x$(cat $d/max_link_width)"
#         done
#
#     目安の帯域: Gen3 x4 = 約 3.9 GB/s、Gen4 x16 = 約 31.5 GB/s。
#     TP の all-reduce と EP の all-to-all は**一番狭いリンクに律速される**。
#     とくに prefill (大バッチ) で効くので、CPU 直結の x16 スロットが空いて
#     いるなら挿し替えるのが、この .env のどの値をいじるより効く。
#     BIOS 側に "PCIe bifurcation" / "x4 モード" の設定があればそれも確認。
#
#     preflight.sh が毎回チェックする。アイドル時はリンク速度が Gen1 まで
#     落ちる (省電力) ので、速度ではなく幅 (width) の方を見ること。
#
# (2) SM120 の NVFP4 MoE カーネルは上流でまだ荒れている
#
#     sm_120 と DGX Spark の sm_121 は同じ SM12x ファミリで、vLLM の
#     `is_device_capability_family(120)` は両方にマッチする。つまり GB10 で
#     踏んでいた経路とほぼ同じ経路を踏むので、まずは素直に動くはず。
#
#     ただし SM12x の NVFP4 MoE 経路には未解決の上流 issue が複数ある
#     (vLLM #31085 / #47749 / #35566、FlashInfer #2577)。症状は
#     「起動はするが出力が壊れる / NaN」「最初のリクエストで illegal memory
#     access」など。踏んだら下の VLLM_MOE_FORCE_MARLIN の節を見ること。
#
#     ★ 起動したら必ず短い質問を 1 本投げて、日本語と英語がまともに返るかを
#       目視すること。このモデルは壊れた経路でも黙って動くことがある。
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# イメージ
#
#   ★ **安定版タグ (v0.29.0) は使えない**。このチェックポイントには
#     vLLM の以下 2 つの修正が両方必要だが、v0.29.0 のリリースブランチは
#     それより前に切られている (main から behind_by 388 で、どちらも未取込):
#
#       d4d703caf908786416585ceb1f369e2e0363358b  (2026-09-03, PR #54882)
#         "Fix FP8 PLE loading in mixed ModelOpt checkpoints"
#         -> 無いと FP8 の PLE テーブルを黙って誤った値でロードする
#            (落ちないので気付きにくい。出力品質だけ壊れる)
#
#       PR #55513 (merged 2026-09-08)
#         "Fix block FP8 MTP in ModelOpt mixed checkpoints"
#         -> 無いと MTP (投機デコード) が使えない
#
#     モデルカードの Usage 節も同じことを要求している。
#
#   下のタグは 2026-09-13 の main (commit 2671fed...) から焼かれた nightly で、
#   両方を含むことを確認済み (d4d703c から ahead 416 / #55513 から ahead 217)。
#   nightly は流動タグなので、commit を含む方のタグで固定している。
#
#   ★ このタグは **multi-arch manifest** なので、DGX Spark ブランチと同じ文字列
#     のままで問題ない。x86_64 の機体では linux/amd64 の方
#     (sha256:53f466b1524d3a9730a302007632d4d640d2ff956245f71a69b608ca35efa70e,
#      8.1 GiB) が自動で引かれる。aarch64 用の cu129 がどうという話は
#     このブランチでは全部忘れてよい。
#
#   ★ ただし amd64 ビルドの CUDA arch list に 12.0 が入っていることは
#     確認すること (preflight.sh がイメージ取得済みなら自動でやる):
#       sudo docker run --rm ${VLLM_IMAGE} \
#         python3 -c 'import torch; print(torch.cuda.get_arch_list())'
#     ここに sm_120 が無いと PTX JIT に落ちて起動が極端に遅くなる。
# -----------------------------------------------------------------------------
VLLM_IMAGE=vllm/vllm-openai:nightly-2671fedfc7ae604761990603fc736c0c4f21de57

# -----------------------------------------------------------------------------
# モデル (約 124 GiB)
#   scripts/fetch-model.sh がこのパスに revision 固定で落とす。
#   1 台構成なので 1 回落とせばよい。
#
#   RadixArk/Qwen3.8-Flash-Next-NVFP4 ではなく nvidia 版を使っている理由:
#     ・RadixArk 版は Supported Runtime が SGLang のみ (モデルカード明記)、
#       検証も GB300/B300 で、vLLM 経路の qualification が無い
#     ・135.3 GiB と 2.5 GiB 大きい
#     ・nvidia 版は vLLM を Supported Runtime に挙げ、FP8 比の精度実測
#       (GPQA/HLE/SciCode/Terminal-Bench 等) を公開している
#   どちらも本体は「routed experts だけ NVFP4 / attention は高精度」で同系統。
# -----------------------------------------------------------------------------
MODEL_PATH=./models/Qwen3.8-Flash-Next-NVFP4
MODEL_CONTAINER_PATH=/models/Qwen3.8-Flash-Next-NVFP4
MODEL_REPO=nvidia/Qwen3.8-Flash-Next-NVFP4
MODEL_REVISION=fc694b54fb0174e0913e6adf86691ef85a4ead47

# 空白区切りでエイリアスを並べられる (entrypoint が set -f して非クォート展開する)
SERVED_MODEL_NAME='qwen3.8-flash-next qwen3.8-flash'

# gated ではないのでトークン無しでも落とせる。レート制限回避に入れてもよい。
HF_TOKEN=

# -----------------------------------------------------------------------------
# トポロジ / API
#
#   単一ノードの 2 GPU なので TP=2 だけ。NNODES も MASTER_ADDR も無い。
#
#   ★ TP_SIZE は「重み 123.5 GiB が収まる最小の枚数」から決める。
#     96 GB 級カードなら 2 枚が下限 (1 枚には載らない)。48 GB 級なら 4 枚。
#     preflight.sh が実機の VRAM を見て成立するかどうか判定する。
#
#   API_BIND_ADDR : ポートを LAN に出すかどうか。同じ機体からしか叩かないなら
#                   127.0.0.1 にしておくのが安全。既定は全 IF。
#   NVIDIA_VISIBLE_DEVICES : GPU を選びたいときだけ 0,1 のように書く。
# -----------------------------------------------------------------------------
TP_SIZE=2
HOST_PORT=8910
API_BIND_ADDR=0.0.0.0
NVIDIA_VISIBLE_DEVICES=all

# -----------------------------------------------------------------------------
# NCCL (単一ノード / PCIe)
#
#   RDMA HCA は無いので IB は切る。NVLink / NVSwitch も無いので NVLS も切る。
#
# -----------------------------------------------------------------------------
#   ★★ NVLink の無い Blackwell ワークステーション機では 1 が必須 ★★
#
#   RTX PRO 6000 Blackwell を PCIe だけで複数枚積んだ構成では、NCCL の P2P 経路が
#   ドライバ / NCCL レベルで壊れている。上流に 100% 再現の報告がある既知の不具合:
#
#     NVIDIA/nccl #1999
#       2x RTX Pro 6000 Blackwell で all_reduce_perf が 100% 再現でハング。
#       NCCL 2.26.5 / 2.27.7 / 2.29.2 いずれも。vLLM は一切関係しない。
#     vllm-project/vllm #33041
#       Blackwell + TP=2 で「NCCL init 後にハング」。TP=1 なら正常に起動する。
#     sgl-project/sglang #15181
#       RTX PRO 6000 Blackwell Max-Q。NCCL_P2P_DISABLE=1 で解決。
#     Level1Techs フォーラム
#       can_device_access_peer() は両方向 true なのに最初の collective でハング。
#       **BIOS で ACS を切っても直らない**。
#
#   ★ 診断ツールを信用しないこと。壊れている機体でも
#       nvidia-smi topo -p2p r    -> 全ペア OK
#       can_device_access_peer()  -> true
#     と出る。「OK だから大丈夫」と読んでこの行をコメントアウトすると、
#     モデルのロードに到達せず固まる。
#
#   ◆ 踏んだときの症状:
#       ・ログが `vLLM is using nccl==X.Y.Z` で止まったまま何時間も動かない
#       ・VRAM は 1 GiB 程度しか使われていない (重みのロードに到達していない)
#       ・GPU util は 100% で電力も張り付く (NCCL カーネルのスピン待ち)
#       ・コンテナを落とした後も **一部の GPU が util 100% のまま残る**。
#         compute プロセスが 1 つも紐づいていない = ドライバ内にカーネルが
#         刺さった状態で、`sudo nvidia-smi -r -i <idx>` かリブートまで戻らない。
#         (preflight.sh がこの wedged 状態を検出する)
#
#   ◆ 代償: all-reduce がホストメモリ経由の bounce buffer になる。
#     上の「落とし穴 (1)」の狭いリンクと重なるとさらに遅い。
#     だからこそ MTP + EP を外して all-to-all を無くす構成が効いてくる。
#
#   ◆ この設定が要らない構成:
#       ・NVLink / NVSwitch で繋がっている (nvidia-smi topo -m に NV# が出る)
#       ・GPU 1 枚だけ (TP_SIZE=1) で collective がそもそも走らない
#     この場合は行ごとコメントアウトする。P2P を殺すと素直に遅くなるので、
#     「効く構成なら使う」が正しい。preflight.sh が NVLink の有無を見て
#     どちらにすべきか教えてくれる。
#
#   ◆ 将来ドライバ / NCCL が直ったら: コメントアウトして起動し、
#     `vLLM is using nccl==` の次の行が出れば直っている。出なければ戻すこと。
# -----------------------------------------------------------------------------
NCCL_P2P_DISABLE=1

#   NCCL_CUMEM_ENABLE=0 は「cuMem API が効かない環境向け」の別の回避策。
#   P2P を切ってもなお init でハングする場合だけ試す。常用しない。
# NCCL_CUMEM_ENABLE=0

NCCL_IB_DISABLE=1
NCCL_NVLS_ENABLE=0
#   ハンドシェイクや経路選択を追いたいときは INFO に上げる。
NCCL_DEBUG=WARN

# 多 GPU で fork 由来の CUDA 初期化エラーが出るときだけ spawn に固定する。
# 近年の vLLM v1 は既定で spawn なので通常は不要。
# VLLM_WORKER_MULTIPROC_METHOD=spawn

# -----------------------------------------------------------------------------
# コンテキスト / メモリ
#
#   ◆ 重みの内訳 (safetensors ヘッダ実測、全体)
#       body (routed experts NVFP4 + attention/shared BF16)   72.6 GiB
#       PLE (51.2B n-gram embedding, per-tensor FP8)          47.7 GiB
#       embed_tokens / lm_head                                 2.4 GiB
#       vision tower                                           0.8 GiB
#       -------------------------------------------------------------
#       合計                                                  123.5 GiB
#     PLE も ETP シャードされるので **1 GPU あたり 123.5 / TP_SIZE GiB**。
#
#   ◆ VRAM 収支の立て方
#       vLLM が確保しにいく上限 = VRAM/GPU x GPU_MEMORY_UTILIZATION
#       そこから重み (123.5 / TP_SIZE GiB) を引いた残りが
#       「活性化 + CUDA graph + KV」になる。残りが 6 GiB を切ると起動しない。
#
#       96 GB 級カード 2 枚 + GPU_MEMORY_UTILIZATION=0.92 の場合:
#         上限   95.6 x 0.92 = 87.9 GiB/GPU
#         - 重み              61.8 GiB
#         -------------------------------
#         残り                26.1 GiB    -> うち KV が 20〜22 GiB
#
#       preflight.sh が実機の VRAM を読んでこの計算をやり直し、KV が何 token
#       分になるかまで出すので、枚数や VRAM が違う機体ではそちらを見ること。
#
#     ★ 専有 VRAM の機体では --kv-cache-memory-bytes を渡さないのが正解。
#       vLLM の起動時メモリプロファイルが正しく効く。
#       UMA の機体 (DGX Spark 等、CPU と GPU がメモリを食い合う構成) では
#       プロファイルが当てにならないので手で固定する必要があるが、
#       このブランチの既定では外してある (下の VLLM_KV_ARGS 参照)。
#
#     ★ デスクトップ環境が乗っている GPU に注意。gnome-shell / Xwayland や
#       ブラウザが数百 MiB〜数 GiB 食い、その分 KV が削られる。
#       GPU_MEMORY_UTILIZATION を 0.92 より上げるなら、先にコンソールだけに
#       するか、その GPU から画面出力を外すこと。
#       preflight.sh が起動前に GPU ごとの使用量を確認する。
#
#   ◆ KV の見積り
#     このモデルは QSA (Qwen Sparse Attention) ハイブリッドで、
#     full_attention_interval=4 なので **48 層中 12 層だけが full attention**。
#     残り 36 層は Gated DeltaNet (状態が定数サイズ、~57 MB/seq/GPU)。
#
#       12 層 x 2 kv-head x 256 head_dim x 2 (K+V) x 2 B (bf16)
#         = 24 KiB/token (全体) -> **24 / TP_SIZE KiB/token/GPU**
#
#     例: TP=2 (12 KiB/token/GPU) で KV が 21 GiB/GPU 取れたなら約 1.8M token:
#       1M   x 1.8 本
#       262K x 7 本
#     MAX_NUM_SEQS の本数ぶん最大長を同時に張れなくても、vLLM が
#     スケジュールを絞る (preemption) だけで落ちはしない。
#
#   ◆ MAX_NUM_BATCHED_TOKENS は prefill 中の活性化メモリを決める
#     長尺で OOM (CUDA out of memory) が出たら**まずここを半分にする**。
#     次に GPU_MEMORY_UTILIZATION ではなく MAX_NUM_SEQS を下げる。
#
#     ★ 上げれば prefill が速くなるとは限らない。下の「prefill が遅いとき」を
#       読んで、計算律速なのか通信律速なのかを先に判定すること。通信律速の機体で
#       ここを上げても prefill は変わらず、活性化メモリのぶん KV が減るだけ。
#
#   ◆ GPU_MEMORY_UTILIZATION の詰め方 (vLLM に計算させる)
#     起動ログに必ずこの行が出る:
#
#       Free memory on device (93.99/94.97 GiB) on startup.
#       Desired GPU memory utilization is (0.97, 92.12 GiB).
#       Actual usage is 64.45 GiB for consumed memory (weights + non-torch),
#       3.31 GiB for peak activation, and 0.13 GiB for CUDAGraph memory.
#       Replace gpu_memory_utilization config with `--kv-cache-memory=...`
#       (25.96 GiB) to fully utilize gpu memory.
#       Current kv cache memory in use is 24.36 GiB.
#
#     手順:
#       1. まず 0.92 あたりで起動してこの行を読む
#       2. "to fully utilize" の値と "in use" の差が詰められる余地
#       3. util を上げて再起動。ただし "Free memory on device" の**左の値**を
#          超える budget にすると起動に失敗する
#       4. `GPU KV cache size: N tokens, Maximum concurrency ...` 行で確認
#
#     ★ "fully utilize" の値まで詰めるのは危険。デスクトップ環境が乗っている
#       GPU ではブラウザを開いた瞬間に OOM する。1〜2 GiB は残すこと。
#
#     既定の 0.97 は「デスクトップが数百 MiB 乗った 96 GB カード」での実測値。
#     他のワークロードと GPU を共有する機体では 0.90 前後まで下げること。
# -----------------------------------------------------------------------------
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=16384
GPU_MEMORY_UTILIZATION=0.97

# -----------------------------------------------------------------------------
# prefill が遅いとき: まず計算律速か通信律速かを判定する
#
#   TP を使っていると、prefill は GPU の演算性能ではなく **GPU 間の帯域**で
#   頭打ちになることが多い。どちらなのかを判定してからレバーを選ばないと、
#   効かない設定をいじって KV を削るだけになる。
#
#   ◆ 判定手順
#
#   1. prefill スループットを測る (max_tokens=1 で長いプロンプトを投げ、
#      TTFT で prompt_tokens を割る)。プロンプト長を 4 倍にしても
#      tok/s がほぼ変わらないなら、チャンク化のオーバーヘッドは償却済み。
#
#   2. 計算側の必要量を出す:
#        active params ≈ layers x (experts_per_tok+1) x 3 x hidden x moe_inter
#                        + attention の投影
#        FLOPs/token ≈ 2 x active params
#        必要 TFLOP/s = FLOPs/token x tok/s
#      これがカードの NVFP4/BF16 ピークの数%しか無ければ**計算律速ではない**。
#
#   3. 通信側の必要量を出す:
#        1 チャンクの all-reduce 量
#          = batched_tokens x hidden x 2 B x layers x 2 (attn出力 + MoE出力)
#        実効帯域 = その量 ÷ 1 チャンクの所要時間
#      これが GPU 間リンクの実力に張り付いていれば**通信律速**。
#      (NCCL_P2P_DISABLE=1 だと host 経由になり、さらに PCIe を 2 回渡るので
#       実効はリンク帯域の半分程度が上限になる)
#
#   ◆ 通信律速だった場合に効くもの / 効かないもの
#
#     効かない: MAX_NUM_BATCHED_TOKENS を上げる / torch.compile /
#               performance-mode の変更 (これは CUDA graph の capture サイズを
#               変えるだけで prefill には無関係)
#
#     効く:
#       ・GPU を x16 スロットに挿し替える (上の「落とし穴 (1)」)。
#         帯域がそのまま prefill に乗る。ソフト側のどの設定より効く。
#       ・NVLink のある機体なら NCCL_P2P_DISABLE を外す
#       ・--enable-prefix-caching (既定で有効)。
#         同じ前置きを再送する使い方では桁違いに効く。実測では 20 万 token の
#         前置きを再利用したケースで 66 秒 -> 0.85 秒 (78 倍)。
#         コーディング用途は system prompt + 同じファイル群の再送が大半なので、
#         実運用の体感はこれでほぼ決まる。
#       ・パイプライン並列 (--pipeline-parallel-size) に替える。
#         TP は層ごとに all-reduce するが、PP はステージ境界で hidden state を
#         1 回渡すだけなので通信量が 2 桁減る。帯域の細い機体では逆転しうる。
#         ただし PLE のような大きな埋め込みがステージ 0 に偏って載るため、
#         GPU ごとのメモリ配分が崩れて OOM することがある。要実験。
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# vLLM 引数は 3 つに分けてある。entrypoint がこの順で `vllm serve` に渡す。
# ★ JSON 値の中に空白を入れないこと (空白で分割しているため)。
# -----------------------------------------------------------------------------

# reasoning は `reasoning` フィールドに分離される。外すと content に混ざる。
# tool 呼び出しは Qwen3.8 系の XML 形式。
VLLM_PARSER_ARGS='--reasoning-parser qwen3 --tool-call-parser qwen3_xml --enable-auto-tool-choice'

# -----------------------------------------------------------------------------
# KV / コンテキスト長
#
#   --hf-overrides で static YaRN を掛けて 262144 -> 1048576 に伸ばす。
#   元の rope_parameters は rope_type=default / rope_theta=1e7 /
#   partial_rotary_factor=0.25 / mrope_interleaved=true /
#   mrope_section=[11,11,10] なので、それを保ったまま
#   rope_type=yarn + factor=4.0 + original_max_position_embeddings=262144
#   を足す形。VLLM_ALLOW_LONG_MAX_MODEL_LEN=1 とセット (compose で既定 1)。
#   モデルカードも "262K natively and extensible up to 1,000,000" と書いている。
#
#   ★ static YaRN は短文の品質をわずかに削る。気になるなら factor 2.0
#     (=524K) に落とすか、--hf-overrides ごと消して 262144 native に戻す。
#     factor を変えたら MAX_MODEL_LEN も一緒に変えること (preflight が検査する)。
#   ★ MTP 側の rope (text_config.mtp.rope_theta) はこの override の対象外。
#     262K を大きく超える位置では drafter の推測が弱くなり、投機の受理率が
#     落ちる可能性がある。長尺で急に遅くなったら k を下げるか MTP を外す。
#
#   --kv-cache-memory-bytes は**指定しない**。専有 VRAM では vLLM の起動時
#     プロファイルが正しく効くので、GPU_MEMORY_UTILIZATION に任せる方が安全。
#     どうしても固定したいなら例えば 21 GiB = 22548578304 を足す。
#   --kv-cache-dtype も**指定しない** (bf16 のまま)。この QSA の KV を fp8 に
#     するのは未検証で、チェックポイントにも KV 量子化メタデータが無い。
#   --block-size 32 : GB10 での先行事例から引き継いだ値。sm_120 では既定
#                     (16) でも動くはずだが、動作実績のある側に寄せている。
#                     起動時に block size 絡みで落ちたら外して既定に戻す。
# -----------------------------------------------------------------------------
VLLM_KV_ARGS='--block-size 32 --hf-overrides {"text_config":{"rope_parameters":{"rope_type":"yarn","rope_theta":10000000,"partial_rotary_factor":0.25,"factor":4.0,"original_max_position_embeddings":262144,"mrope_interleaved":true,"mrope_section":[11,11,10]}}}'

# -----------------------------------------------------------------------------
# 量子化 / 投機デコード / 速度レバー (コーディング用途向けの既定)
#
#   --quantization は**指定しない** (自動検出に任せる)
#       ★ モデルカードの Usage には `--quantization modelopt` と書いてあるが、
#         現行の vLLM にそのまま渡してはいけない。vLLM 側で ModelOpt 系の
#         量子化名が細分化されており、
#             modelopt        -> FP8 経路   (quant_algo FP8_PB_WO 用)
#             modelopt_fp4    -> NVFP4 経路 (quant_algo NVFP4 / W4A16_NVFP4 用)
#             modelopt_mixed  -> 混合経路   (quant_algo MIXED_PRECISION 用)
#         と分かれている。このチェックポイントの hf_quant_config.json は
#         "quant_algo": "MIXED_PRECISION" (routed experts だけ NVFP4、
#         MTP は block FP8、残りは BF16) なので、正解は modelopt_mixed。
#         `modelopt` を明示すると FP8 経路を名指しすることになる。
#         省けば ModelOptMixedPrecisionConfig.override_quantization_method が
#         MIXED_PRECISION を見て modelopt_mixed に解決してくれる。
#         どうしても明示したいなら --quantization modelopt_mixed と書く。
#
#   --enable-expert-parallel  ★ TP=2 では**必須**
#       MTP の routed experts は 128x128 ブロックの FP8。moe_intermediate_size
#       は 640 なので、TP=2 で intermediate 次元を割ると 320 になり
#       **128 の倍数でなくなってブロックレイアウトが壊れる**。EP なら
#       expert 数 (512) の方を 256/256 に割るので各 expert の幅 640 が保たれる。
#       nvidia のモデルカードが 8 GPU で MTP を使うときに EP を要求しているのも
#       同じ理由。
#
#       ★ EP の all-to-all は上の「落とし穴 (1)」の PCIe x4 を直撃する。
#         もし prefill が耐えられないほど遅かったら、**EP と MTP を
#         セットで外す**という選択肢がある (下の「MTP を外す場合」参照)。
#         EP だけ外して MTP を残すのは不可 (ブロックレイアウトが壊れる)。
#
#   --speculative-config mtp k=3
#       チェックポイント同梱の MTP ヘッド (mtp_num_hidden_layers=1) を使う。
#       drafter の別ダウンロードは不要。nvidia のサンプルは 8xB200 で k=1。
#       GB10 は帯域律速なので k=3 が効いたが、この GPU は帯域に余裕がある分
#       k の効きは落ちる可能性がある。受理率が低くて遅いようなら 2 -> 1。
#
#       ---- MTP を外す場合 (EP も一緒に外す) ----
#       本体の routed experts は NVFP4 (ブロックスケールは 16 要素単位) なので、
#       640 / 2 = 320 でも割り切れる。つまり MTP を使わないなら EP は不要で、
#       通信は all-reduce だけになり x4 リンクへの負荷が大きく下がる。
#       その場合はこの行を丸ごと下に差し替える:
#
#         VLLM_EXTRA_ARGS='--performance-mode interactivity --enable-prefix-caching --enable-chunked-prefill --no-enable-flashinfer-autotune --disable-custom-all-reduce'
#
#   --performance-mode interactivity
#       「小バッチでの end-to-end レイテンシ優先 (細粒度 CUDA graph +
#        レイテンシ志向カーネル)」。単ユーザのコーディング用途はこれ。
#       多人数で同時に叩くなら throughput に変える。
#
#   --enable-prefix-caching
#       コーディングでは system prompt + 同じファイル群が毎リクエスト再送
#       されるので、これが一番効く。
#
#   --no-enable-flashinfer-autotune
#       nvidia のモデルカードが MTP 併用時に指定している。SM120 では
#       FlashInfer の FP4 GEMM 自体に既知の不具合があるので、オートチューンを
#       走らせない方が無難という意味でも都合がよい。
#
#   --disable-custom-all-reduce  ★ NCCL_P2P_DISABLE=1 の機体では実質必須
#       vLLM 独自の all-reduce は CUDA IPC / P2P を前提にしているので、
#       P2P を切った環境では意味がないどころかハングの種になる。
#       vLLM 側も P2P が無いと判定すれば自動で無効化するが、Blackwell PCIe 機で
#       「worker 初期化中にハングする。--disable-custom-all-reduce で直った」
#       という報告が複数あるので明示的に切っておく。
#       上の NCCL_P2P_DISABLE の節とセットで読むこと。
#
#   ---- さらに速度が欲しいときの未検証レバー ----
#   --async-scheduling            : スケジューリングと forward を重ねる。
#                                   投機デコードとの併用は未検証。
#   --compilation-config {"cudagraph_mode":"FULL_DECODE_ONLY",...}
#                                 : interactivity が自動で面倒を見るので
#                                   まずは触らない。
# -----------------------------------------------------------------------------
VLLM_EXTRA_ARGS='--enable-expert-parallel --speculative-config {"method":"mtp","num_speculative_tokens":3} --performance-mode interactivity --enable-prefix-caching --enable-chunked-prefill --no-enable-flashinfer-autotune --disable-custom-all-reduce'

# -----------------------------------------------------------------------------
# SM120 の NVFP4 MoE が壊れていたときの切り分け (既定は未設定)
#
#   症状: 起動はするのに出力が意味不明 / NaN / 最初のリクエストで
#         "CUDA illegal memory access in MoE layer"。
#
#   1 にすると routed experts の GEMM を CUTLASS NVFP4 ではなく Marlin の
#   W4A16 (dequant してから計算する経路) に落とす。4x RTX PRO 6000 での
#   コミュニティ報告では、SM120 で唯一まともな出力が出たのがこの経路だった。
#
#   ★ ただし Marlin は「NVFP4 のスケールが非負である前提」で書かれており、
#     負のスケールを持つチェックポイントでは別の壊れ方をするという報告もある。
#     万能の回避策ではなく、あくまで切り分け用。
#   ★ 同じ報告では Marlin + MTP の組み合わせが受理率を落として逆効果
#     (-22%) だったので、これを 1 にするなら MTP も外して比べること。
#
#   関連 issue: vllm-project/vllm #31085 / #47749 / #35566,
#               flashinfer-ai/flashinfer #2577
# -----------------------------------------------------------------------------
# VLLM_MOE_FORCE_MARLIN=1

# -----------------------------------------------------------------------------
# SM12x 数値契約 (さわらない)
#
#   ★ VLLM_USE_DEEP_GEMM=0 は GB10 ブランチから維持。DeepGEMM は sm_90a /
#     sm_100a 向けで SM12x 用のカーネルが無い。現行 vLLM は capability を見て
#     自分で外すはずだが、万一選ばれると黙って壊れる経路なので明示的に殺す。
#     このチェックポイントは MTP の routed experts が 128x128 block FP8 なので
#     block-FP8 経路は確実に踏む。
#
#   ★ 他ブランチから以下を持ってこないこと。現在の vLLM main には**もう
#     存在しない**環境変数で、書いても警告が出るだけ:
#       VLLM_NVFP4_GEMM_BACKEND / VLLM_USE_FLASHINFER_MOE_FP4
#     DeepSeek ブランチの VLLM_USE_DEEP_GEMM_E8M0 / VLLM_MOE_USE_DEEP_GEMM も
#     DeepSeek の FP8 経路向けで、この NVFP4 構成には関係しない。
#
#   ★ VLLM_NCCL_SO_PATH は**書かない**。DGX Spark ブランチには
#     /usr/lib/aarch64-linux-gnu/libnccl.so.2 が入っていたが、x86_64 では
#     存在しないパスで、指定するとロードに失敗する。イメージ同梱の NCCL に任せる。
# -----------------------------------------------------------------------------
VLLM_USE_DEEP_GEMM=0
VLLM_ALLOW_LONG_MAX_MODEL_LEN=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
VLLM_EXECUTE_MODEL_TIMEOUT_SECONDS=1800
# ランタイム JIT は放っておくと nproc 分の nvcc を撒いてホスト RAM を食い潰す。
# コア数の多い機体ほど効くので、nproc ではなくこの値で頭打ちにする。
MAX_JOBS=8
