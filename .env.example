# GLM-5.3-Flash UNCENSORED / kindling TP=3. Same .env on all three hosts.
# Roles are selected by docker compose --profile head|worker1|worker2.
# First boot builds the image automatically from the prepared pinned source.
VLLM_IMAGE=llm-glm53-kindling:tp3-v2

# Download only into SOURCE_MODEL_PATH. Serving shards are immutable hardlinks.
SOURCE_MODEL_PATH=./models/GLM-5.3-Flash-UNCENSORED-NVFP4
MODEL_PATH=./models/GLM-5.3-Flash-UNCENSORED-NVFP4-kindling-tp3
MODEL_CONTAINER_PATH=/models/GLM-5.3-Flash-UNCENSORED-NVFP4
SERVED_MODEL_NAME=glm-5.3-flash-uncensored glm-5.3-flash
HOST_PORT=8910
STATUS_PORT=8082

TP_SIZE=3
# --- 3-box ring: one QSFP cable per pair, no switch ---------------------------
# Control plane (mentat, Gloo, NCCL bootstrap) uses the management LAN (enP7s7):
# on a ring no single RoCE address reaches both peers. These are DHCP leases;
# update them (or reserve them) if they change.
HEAD_NODE_IP=192.168.aaa.xxx
WORKER1_NODE_IP=192.168.aaa.yyy
WORKER2_NODE_IP=192.168.aaa.zzz
# Cabling (example addresses). Each cable carries one subnet per PCIe root, root 0 (enp1s0f*) on
# the even subnet and root 1 (enP2p1s0f*) on the odd one. Host part = node:
# head .1 / worker1 .2 / worker2 .3. MTU 9000 on all four ports.
#   head    f1 - worker1 f0   192.168.0.0/24, 192.168.1.0/24
#   worker1 f1 - worker2 f0   192.168.2.0/24, 192.168.3.0/24
#   worker2 f1 - head    f0   192.168.4.0/24, 192.168.5.0/24
FABRIC_SUBNETS=192.168.0. 192.168.1. 192.168.2. 192.168.3. 192.168.4. 192.168.5.
MENTAT_ANNOUNCE_IFACES=en*f*np*=connectx+rdma,enP7s7=lan
# A ring claim places rank i on member i in cable order and hands each rank its
# prev/next interfaces; kindling's fabric_ring.py turns them into NCCL's Ring
# graph and arx's ring devices. arxbig's ring does not take 3 ranks.
MENTAT_CLAIM_LAYOUT=ring
MENTAT_CLAIM=glm53-uncensored-tp3
VLLM_ARXBIG=0
# The pre-launch all-reduce runs before ring placement and assumes a mesh.
FABRIC_CHECK=0
# Used by preflight (same order in both lists).
ROCE_IF_NAME=enp1s0f0np0,enP2p1s0f0np0,enp1s0f1np1,enP2p1s0f1np1
IB_HCA_NAME=rocep1s0f0,roceP2p1s0f0,rocep1s0f1,roceP2p1s0f1
NCCL_IB_GID_INDEX=
NCCL_IB_ADDR_RANGE=192.168.0.0/21
NCCL_IB_MERGE_NICS=0
NCCL_CROSS_NIC=1
# On a 1-GPU node NCCL sends on the graph's receive NIC (ncclTopoGetNetDev index 0),
# which faces the other neighbour. Subnet-aware routing makes the sender switch
# to its NIC on the receiver's subnet.
NCCL_IB_SUBNET_AWARE_ROUTING=1
NCCL_BUFFSIZE=1048576
NCCL_LL128_BUFFSIZE=262144
NCCL_PROTO=^LL128
NCCL_MAX_NCHANNELS=8
NCCL_DEBUG=WARN

# 1M: target three full-length requests
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=8192
LONG_PREFILL_TOKEN_THRESHOLD=7168
GPU_MEMORY_UTILIZATION=0.85
# Explicit KV bytes override utilization for cache sizing; keep startup margin.
KV_CACHE_MEMORY=25769803776
BLOCK_SIZE=3456
MTP_NUM_SPECULATIVE_TOKENS=3
GLM53_DENSE_FP8=1
# k=3 => 4 tokens per sequence. Largest graph = max_num_seqs * (k+1).
CUDAGRAPH_CAPTURE_SIZES=4 8 16 32
MAX_JOBS=4
