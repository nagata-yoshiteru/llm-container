# GLM-5.3-Flash UNCENSORED / kindling TP=3. Same .env on all three hosts.
# Roles are selected by docker compose --profile head|worker1|worker2.
# First boot builds the image automatically from the prepared pinned source.
VLLM_IMAGE=llm-glm53-kindling:tp3-v2

# Download only into SOURCE_MODEL_PATH. Serving shards are immutable hardlinks.
SOURCE_MODEL_PATH=./models/GLM-5.3-Flash-UNCENSORED-NVFP4
MODEL_PATH=./models/GLM-5.3-Flash-UNCENSORED-NVFP4-kindling-tp3
MODEL_CONTAINER_PATH=/models/GLM-5.3-Flash-UNCENSORED-NVFP4
SERVED_MODEL_NAME=glm-5.3-flash-uncensored glm-5.3-flash
HOST_PORT=8910
STATUS_PORT=8082

TP_SIZE=3
HEAD_ROCE_IP=192.168.0.1
WORKER1_ROCE_IP=192.168.0.2
WORKER2_ROCE_IP=192.168.0.3
HEAD_ROCE_IP_2=192.168.1.1
WORKER1_ROCE_IP_2=192.168.1.2
WORKER2_ROCE_IP_2=192.168.1.3
CLUSTER_SUBNET=192.168.0.
FABRIC_SUBNETS=192.168.0. 192.168.1.
# Used by preflight; kindling discovers runtime NICs/HCA/GID from the addresses.
ROCE_IF_NAME=enp1s0f0np0,enP2p1s0f0np0
IB_HCA_NAME=rocep1s0f0,roceP2p1s0f0
NCCL_IB_GID_INDEX=
NCCL_IB_ADDR_RANGE=192.168.0.0/24,192.168.1.0/24
NCCL_IB_MERGE_NICS=1
NCCL_CROSS_NIC=1
NCCL_BUFFSIZE=1048576
NCCL_LL128_BUFFSIZE=262144
NCCL_PROTO=^LL128
NCCL_MAX_NCHANNELS=8
NCCL_DEBUG=WARN

# Initial TP=3 memory budget; 1M is not yet validated on this stack.
MAX_MODEL_LEN=524288
MAX_NUM_SEQS=8
MAX_NUM_BATCHED_TOKENS=8192
LONG_PREFILL_TOKEN_THRESHOLD=7168
GPU_MEMORY_UTILIZATION=0.85
KV_CACHE_MEMORY=12884901888
BLOCK_SIZE=3456
MTP_NUM_SPECULATIVE_TOKENS=3
GLM53_DENSE_FP8=1
# k=3 => 4 tokens per sequence. Largest graph = max_num_seqs * (k+1).
CUDAGRAPH_CAPTURE_SIZES=4 8 16 32
MAX_JOBS=4
