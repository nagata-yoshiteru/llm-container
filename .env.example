# =============================================================================
# DeepSeek-V4-Flash-0731 / 2x DGX Spark (GB10) — 共通 .env
#
# 2 台とも「同じ内容」の .env を置く。head / worker の違いは compose の
# --profile head / --profile worker だけで表現する。
#
#   cp .env.example .env
#
# 注意: このファイルは `sudo docker compose` から読まれる。${HOME} などの
# シェル変数は使わず、必ず絶対パスで書くこと (sudo で HOME=/root になるため)。
# =============================================================================

# -----------------------------------------------------------------------------
# イメージ (digest 固定 / linux-arm64 / vLLM 0.25.0 native DSpark k=7)
#   ghcr.io/bjk110/vllm-spark
#   tag 名は v025-native-dspark-k7-promotion-candidate-85deaf7 だが、
#   タグは動くので digest で固定する。
# -----------------------------------------------------------------------------
VLLM_IMAGE=ghcr.io/bjk110/vllm-spark@sha256:aacb06de60ecdc1bcafca5209aa5f0973eb86ab786212c988847ce53575ed84c

# -----------------------------------------------------------------------------
# モデル (2 台とも同じ絶対パスに置くこと)
#   scripts/fetch-model.sh がこのパスにダウンロードする
# -----------------------------------------------------------------------------
MODEL_PATH=./models/DeepSeek-V4-Flash-0731
MODEL_CONTAINER_PATH=/models/DeepSeek-V4-Flash-0731
SERVED_MODEL_NAME=deepseek-v4-flash

# -----------------------------------------------------------------------------
# トポロジ / ネットワーク
#   HEAD_ROCE_IP / WORKER_ROCE_IP は QSFP 直結リンク側の IP。
#   NVIDIA connect-two-sparks の netplan は link-local (169.254.x.x) を振るので、
#   再起動後に変わっていないか `ip -br addr show enp1s0f0np0` で確認すること。
#   IB_HCA_NAME は「ケーブルが刺さっている方」の HCA。`show_gids` で
#   IPv4 が上の IP になっている行の DEV 名と INDEX を読むこと。
# -----------------------------------------------------------------------------
TP_SIZE=2
NNODES=2
MASTER_PORT=29501

HEAD_ROCE_IP=169.254.xxx.xxx
WORKER_ROCE_IP=169.254.yyy.yyy
ROCE_IF_NAME=enp1s0f0np0
IB_HCA_NAME=rocep1s0f0
NCCL_IB_GID_INDEX=3

HOST_PORT=8910

# -----------------------------------------------------------------------------
# メモリ / コンテキスト
#
#   GB10 は CPU/GPU 共有の unified memory 121GB。重み 167GB を TP=2 で割って
#   1 台あたり約 78GiB、そこに下の VLLM_EXTRA_ARGS で固定した KV が乗る。
#   起動前に他のコンテナを止めてキャッシュを落とすこと (scripts/preflight.sh)。
#
#   KV の実測レート (この構成で /metrics から実測):
#       kv_cache_memory_bytes 10GiB -> kv_cache_size_tokens 82,130
#       = 約 128KiB/token
#   MAX_NUM_SEQS=1 なら必要な KV はほぼ MAX_MODEL_LEN x 128KiB。
#   vLLM は KV プールが MAX_MODEL_LEN に足りないと起動時に即エラーで落ちる。
#
#     MAX_MODEL_LEN | 必要 KV | --kv-cache-memory-bytes | 重み込みの総量
#     --------------|---------|-------------------------|----------------
#        65536 (64K)|  8.0GiB | 10737418240 (10GiB)     |  88GiB  実績あり
#       131072(128K)| 16.0GiB | 19327352832 (18GiB)     |  96GiB  <- 既定
#       262144(256K)| 32.0GiB | 36507222016 (34GiB)     | 112GiB  ほぼ入らない
#
#   ノードの unified memory は 119GiB、重みが 1 台 78GiB。256K は KV だけで
#   32GiB 要るので、活性化メモリを足すと現実的に収まらない。
#   256K 以上を狙うなら KV dtype を削る方 (下の VLLM_EXTRA_ARGS のコメント参照)。
# -----------------------------------------------------------------------------
MAX_MODEL_LEN=131072
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.87

# -----------------------------------------------------------------------------
# パーサ類 (OpenAI 互換 API で thinking / tool call をまともに扱うため)
#   これを外すと reasoning が content=null 側に出てクライアントが壊れる。
#   起動時に "unknown reasoning parser" 等で落ちたら、まず空にして素の起動を通す。
#   トークナイザで問題が出る場合は末尾に --tokenizer-mode deepseek_v4 を足す。
# -----------------------------------------------------------------------------
VLLM_PARSER_ARGS=--reasoning-parser deepseek_v4 --tool-call-parser deepseek_v4 --enable-auto-tool-choice

# -----------------------------------------------------------------------------
# vLLM 追加フラグ
#
#   JSON 値の中には絶対に空白を入れないこと (entrypoint が空白で分割するため)。
#
#   --speculative-config dspark k=7 : 0731 が同梱する DSpark draft モジュール。
#                                     蒸留なしで速度を稼いでいる本体。
#   --kv-cache-memory-bytes 18GiB   : UMA では自動プロファイルが当てにならないので固定。
#                                     上の表に合わせて MAX_MODEL_LEN と一緒に動かすこと。
#   --kv-cache-dtype fp8            : 256K 以上を狙うならここを nvfp4_ds_mla にすると
#                                     KV が半分になる (要 1M コンテキストの他レシピ)。
#                                     ただしこのイメージで通るかは未検証。ダメなら
#                                     "Invalid value for kv-cache-dtype" で即落ちる。
#   --block-size 256                : 長コンテキストではこれが要る。vLLM 公式 recipe も
#                                     DeepSeek-V4 に 256 を指定している。起動時に block
#                                     size 絡みで落ちたら外す。
#   --moe-backend marlin            : SM121 で速い FP4 MoE GEMM。
#   --no-enable-prefix-caching      : MAX_NUM_SEQS=1 では効かない上に KV を食う。
#   --compilation-config            : decode 用 CUDA graph を size 8 の 1 本だけ捕る。
#                                     draft 側は eager (round_up(8,7)=14 > 7 のため捕れない)。
# -----------------------------------------------------------------------------
VLLM_EXTRA_ARGS=--no-enable-prefix-caching --kv-cache-dtype fp8 --kv-cache-memory-bytes 19327352832 --block-size 256 --moe-backend marlin --skip-mm-profiling --speculative-config {"method":"dspark","num_speculative_tokens":7,"draft_sample_method":"greedy"} --compilation-config {"cudagraph_mode":"FULL_DECODE_ONLY","cudagraph_capture_sizes":[8],"cudagraph_num_of_warmups":2}

# -----------------------------------------------------------------------------
# SM121 数値契約 / NCCL (基本さわらない)
# -----------------------------------------------------------------------------
VLLM_USE_DEEP_GEMM_E8M0=1
VLLM_MOE_USE_DEEP_GEMM=0
FLASHINFER_CUDA_ARCH_LIST=12.1
TORCH_CUDA_ARCH_LIST=12.1a
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
VLLM_NCCL_SO_PATH=/usr/lib/aarch64-linux-gnu/libnccl.so.2
NCCL_IB_DISABLE=0
NCCL_NVLS_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
# ハンドシェイクを追う時は INFO に上げる
NCCL_DEBUG=WARN
MAX_JOBS=4
