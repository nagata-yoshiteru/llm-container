# =============================================================================
# DeepSeek-V4-Flash-Vision-Exp / 2x DGX Spark (GB10) — 共通 .env
#
#   cp .env.example .env
#
# 2 台とも同じ内容を置く。head / worker の違いは compose の --profile だけ。
# `sudo docker compose` から読まれるので ${HOME} 等のシェル変数は使えない。
#
# 既定は 1M コンテキスト構成。短くするなら presets/ を重ねる:
#   sudo docker compose --env-file .env --env-file presets/256k.env --profile head up -d
# =============================================================================

# -----------------------------------------------------------------------------
# イメージ (digest 固定 / linux-arm64 / CUDA 13.0.1 / vLLM 0.29 系 pre-release)
#   vllm/vllm-openai:deepseekv4-flash-vision-arm64-cu130
#
#   ★ 0731 から一番大きく変わったのがここ。
#
#   Vision-Exp の視覚モジュールはまだ安定版 wheel に入っていない (上流 PR #54566)。
#   通常の release で起動すると text-only のモデルクラスに解決されて vision の
#   テンソルで落ちるので、上流が出しているこの pre-release タグを使う。
#
#   0731 で使っていた ghcr.io/bjk110/vllm-spark (vLLM 0.25 / SM121 ネイティブ) には
#   vision 実装が無い。タグ一覧を見ても vision 対応版はまだ出ていない
#   (最新は v027-ngc2607-dsv4-0731-*)。なので上流イメージに移る。
#
#   SM121 (GB10) のカーネルは上流イメージにも入っているので、そこは問題ない:
#     TORCH_CUDA_ARCH_LIST=8.7 8.9 9.0 10.0+PTX 12.0 12.1    <- 12.1 = GB10
#   CUDA 13.0.1 / NCCL 2.30.7 / libibverbs-dev 入り / root 実行 / bash あり。
#   ホストのドライバは 580.173.02 なので CUDA 13.0 の要件を満たす。
#
#   CUDA 13 で問題が出たら cu129 版に落とす (同じ vLLM / 同じ vision 対応):
#     VLLM_IMAGE=vllm/vllm-openai@sha256:3fde43b84ee75e44704d7b4160a5dcdb7ad0dce99aba95b8b4fa8e756e2ece32
#
#   なお HPC-X (/opt/hpcx/...) はこのイメージには無い。下の
#   VLLM_LD_LIBRARY_PATH_EXTRA でそこを上書きしている。
# -----------------------------------------------------------------------------
VLLM_IMAGE=vllm/vllm-openai@sha256:8568b4bbc821903d93a0a9c17dd80382fdc0ba78eaa128e3eb5cb71c3bf06b79

# -----------------------------------------------------------------------------
# モデル (2 台とも同じ絶対パスに置くこと)
#   scripts/fetch-model.sh がこのパスにダウンロードする
# -----------------------------------------------------------------------------
MODEL_PATH=./models/DeepSeek-V4-Flash-Vision-Exp
MODEL_CONTAINER_PATH=/models/DeepSeek-V4-Flash-Vision-Exp
# 空白区切りでエイリアスを並べられる (entrypoint が set -f して非クォート展開する)。
# 0731 のときの名前も残してあるので、既存クライアントの model: deepseek-v4-flash も
# そのまま通る。
SERVED_MODEL_NAME=deepseek-v4-flash-vision deepseek-v4-flash

# -----------------------------------------------------------------------------
# トポロジ / ネットワーク
#   HEAD_ROCE_IP / WORKER_ROCE_IP は QSFP 直結リンク側の IP。
#   NVIDIA connect-two-sparks の netplan は link-local (169.254.x.x) を振るので、
#   再起動後に変わっていないか `ip -br addr show enp1s0f0np0` で確認すること。
#   IB_HCA_NAME は「ケーブルが刺さっている方」の HCA。`show_gids` で
#   IPv4 が上の IP になっている行の DEV 名と INDEX を読むこと。
# -----------------------------------------------------------------------------
TP_SIZE=2
NNODES=2
MASTER_PORT=29501

HEAD_ROCE_IP=169.254.xxx.xxx
WORKER_ROCE_IP=169.254.yyy.yyy
ROCE_IF_NAME=enp1s0f0np0
IB_HCA_NAME=rocep1s0f0
NCCL_IB_GID_INDEX=3

# QSFP をリング配線していて、worker 側が相手を向けているポートの名前が head と
# 違う場合だけ設定する (2 台直結なら普通は同じなので不要)。未設定なら上の値。
# WORKER_ROCE_IF_NAME=enp1s0f1np1
# WORKER_IB_HCA_NAME=rocep1s0f1
# WORKER_NCCL_IB_GID_INDEX=3

# -----------------------------------------------------------------------------
# dual-HCA (帯域をほぼ倍にする / 要ネットワーク作業)
#
#   GB10 の QSFP ケージは PCIe x4 が 2 本で、**2 枚の独立した NIC に見える**。
#   1 枚しか設定しないと帯域を半分捨てることになる。`ibdev2netdev` で 2 本目が
#   ACTIVE なのに IP が無いなら、この構成が使える。
#   上流報告では 98 -> 161 Gb/s (busbw +64%)、単発 decode で +8%。
#
#   前提: 2 本目を **1 本目と別サブネット**にして MTU 9000、両ノードとも netplan で
#   永続化 (README 参照)。PCIe が Gen5 x4 で上がっているかも確認すること
#   (古い BIOS は第 2 コントローラを Gen5 x2 で配線する)。
# IB_HCA_NAME=rocep1s0f0,roceP2p1s0f0
# ROCE_IF_NAME=enp1s0f0np0,enP2p1s0f0np0
# NCCL_IB_MERGE_NICS=1
# NCCL_CROSS_NIC=1
#
#   ★ dual-HCA では NCCL_IB_GID_INDEX を必ず**空にする**。GID の index は
#     リンクイベントでずれ (上流で 30 分で 3 -> 4)、ずれると片方の HCA だけ
#     ibv_modify_qp failed (61) になって **モデルロード後に TP ハンドシェイクが
#     無言でハングする**。最近の NCCL は自力で RoCEv2/IPv4 GID を選ぶ。
# NCCL_IB_GID_INDEX=

HOST_PORT=8910

# -----------------------------------------------------------------------------
# コンテキスト / メモリ  (既定 = 1M。実測値は presets/README.md)
#
#   ★ 下の数値は 0731 での実測。Vision-Exp では KV のレートが変わる
#     (num_nextn_predict_layers が 1 -> 3、vision tower が BF16 で乗る) ので、
#     起動したら必ず /metrics の kv_cache_size_tokens / max_concurrency を
#     読み直すこと。判断基準は max_concurrency >= 1.0。
#
#   unified memory 121GiB のうち、重み 78GiB + ランタイム 15GiB は固定費。
#   KV は --kv-cache-memory-bytes で固定確保する (UMA では自動プロファイルが
#   当てにならないため)。20GiB で max_concurrency 1.69、idle 残 7GiB。
#
#   MAX_NUM_BATCHED_TOKENS が prefill 中の活性化メモリを決める。長尺で
#   OOM-kill されたらここを下げる。8192 のとき 900K prefill で残 1.9GiB。
# -----------------------------------------------------------------------------
MAX_MODEL_LEN=1048576
MAX_NUM_SEQS=1
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.87

# -----------------------------------------------------------------------------
# vLLM 引数は 3 つに分けてある。entrypoint がこの順で `vllm serve` に渡す。
# JSON 値の中に空白を入れないこと (空白で分割しているため)。
#   VLLM_PARSER_ARGS : パーサ類。全構成共通
#   VLLM_KV_ARGS     : KV 関連。presets/ が上書きするのはここだけ
#   VLLM_EXTRA_ARGS  : その他。全構成共通
# -----------------------------------------------------------------------------

# 外すと thinking が content に混ざる。thinking は `reasoning` フィールドに入る。
#
# --reasoning-config は Vision-Exp のモデルカードが追加で指定しているもの。この
# チェックポイントは reasoning の開始/終了マーカを持たないので空文字を渡す。
# (JSON の中に空白を入れないこと。entrypoint が空白で分割するため)
#
# reasoning effort (low/high/max) はサーバ側フラグではなく、リクエストの
# chat_template_kwargs で渡す。評価時は max / temperature 1.0 / top_p 0.95。
VLLM_PARSER_ARGS=--reasoning-parser deepseek_v4 --tool-call-parser deepseek_v4 --enable-auto-tool-choice --reasoning-config {"reasoning_parser":"deepseek_v4","reasoning_start_str":"","reasoning_end_str":""}

# -----------------------------------------------------------------------------
# vLLM 追加フラグ
#
#   JSON 値の中には絶対に空白を入れないこと (entrypoint が空白で分割するため)。
#   entrypoint は VLLM_PARSER_ARGS -> VLLM_KV_ARGS -> VLLM_EXTRA_ARGS の順に
#   `vllm serve` へ渡す。
#
#   このうち構成ごとに変わるのは VLLM_KV_ARGS だけ。presets/ のオーバーレイは
#   MAX_MODEL_LEN / MAX_NUM_BATCHED_TOKENS / VLLM_KV_ARGS の 3 つしか上書きしない。
#
#   --kv-cache-memory-bytes 20GiB : UMA では自動プロファイルが当てにならないので固定。
#                                   上の表に合わせて MAX_MODEL_LEN と一緒に動かすこと。
#   --kv-cache-dtype fp8          : 512K 以上を狙うならここを fp8_ds_mla にする
#                                   (DeepSeek MLA 専用のパック済みレイアウト)。
#                                   未検証。presets/1m-ds-mla.env を参照。
#   --block-size 256              : 長コンテキストではこれが要る。vLLM 公式 recipe も
#                                   DeepSeek-V4 に 256 を指定している。これの有無で KV の
#                                   レートが倍違う (外すと 67,470 -> 130,737 B/token)。
#                                   起動時に block size 絡みで落ちたら外す。
# -----------------------------------------------------------------------------
VLLM_KV_ARGS=--kv-cache-dtype fp8 --kv-cache-memory-bytes 21474836480 --block-size 256

# -----------------------------------------------------------------------------
#   ここから下は全構成で共通。presets/ でも上書きしない。
#
#   --speculative-config dspark k=3 : Vision-Exp が同梱する DSpark draft モジュール。
#                                     0731 の k=7 から 3 に下げた。config.json の
#                                     num_nextn_predict_layers が 1 -> 3 に変わっており、
#                                     モデルカードも vLLM recipe も 3 を指定している。
#                                     recipe の実測は受理率 66.3% / 平均 2.99 tok/forward。
#                                     訓練時の block 幅は 5 だが数字が出ているのは深さ 3
#                                     だけなので、上げるなら自分で検証すること。
#                                     draft_sample_method も greedy -> probabilistic に、
#                                     enable_adaptive_verification は **false**。
#                                     ★モデルカードは true を指定しているが GB10 では
#                                     使えない。実機で出たエラー:
#                                       ValueError: Adaptive verification trims
#                                       verification requests on device, which the
#                                       DeepseekV4IndexerBackend attention backend
#                                       does not support.
#                                     モデルカードのコマンドは 4xGB300 向けなので、
#                                     そちらは別の backend に解決されているのだろう。
#
#                                     recipe は "model":"deepseek-ai/..." も渡しているが
#                                     ここでは省いている。draft の重みは本体チェック
#                                     ポイントに同梱されているし、HF_HUB_OFFLINE=1 で
#                                     repo id を解決させるとオフラインで落ちる。
#                                     0731 でも省略して動いていた。
#
#   --moe-backend marlin            : SM121 で速い FP4 MoE GEMM。0731 での実測に基づく。
#                                     ★ここだけ未検証。vLLM 0.29 では選択肢名が変わって
#                                       いる可能性がある。起動直後に invalid choice /
#                                       unrecognized で落ちたら、まずこれを外して試す。
#                                       (vision recipe 側は moe-backend を指定していない)
#   --no-enable-prefix-caching      : MAX_NUM_SEQS=1 では効かない上に KV を食う。
#   --compilation-config            : decode 用 CUDA graph を size 4 の 1 本だけ捕る。
#                                     k=7 のときは 1+7=8 だったが、k=3 なので 1+3=4。
#
#   --skip-mm-profiling は外した。0731 は text-only だったので付けていたが、
#   Vision-Exp で付けたままにすると vision encoder の活性化メモリを見積もらずに
#   起動してしまい、画像入りリクエストで OOM-kill される。
#   逆に起動時の mm profiling でメモリが足りなくなったら、
#   --limit-mm-per-prompt {"image":1} を足して 1 枚に絞る。
# -----------------------------------------------------------------------------
VLLM_EXTRA_ARGS=--no-enable-prefix-caching --moe-backend marlin --speculative-config {"method":"dspark","num_speculative_tokens":3,"draft_sample_method":"probabilistic","enable_adaptive_verification":false} --compilation-config {"cudagraph_mode":"FULL_DECODE_ONLY","cudagraph_capture_sizes":[4],"cudagraph_num_of_warmups":2}

# -----------------------------------------------------------------------------
# SM121 数値契約 / NCCL (さわらない)
#   VLLM_USE_DEEP_GEMM_E8M0=1 は必須。外すと速度が 1/7 になる
#
#   ここは 0731 (bjk110 イメージ) 時代の値をそのまま持ってきている。上流イメージで
#   未登録の変数だと vLLM が "Unknown vLLM environment variable" を出すだけで落ちは
#   しないので、警告が出たらログを見て判断すること。
# -----------------------------------------------------------------------------
VLLM_USE_DEEP_GEMM_E8M0=1
VLLM_MOE_USE_DEEP_GEMM=0
FLASHINFER_CUDA_ARCH_LIST=12.1
TORCH_CUDA_ARCH_LIST=12.1a
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
# 上流イメージは NCCL 2.30.7 を apt (libnccl2) で入れているので、このパスで合う。
# もし "cannot open shared object file" が出たら、この行を空にすれば
# entrypoint が unset して torch 同梱の NCCL に任せる。
VLLM_NCCL_SO_PATH=/usr/lib/aarch64-linux-gnu/libnccl.so.2

# compose の既定値は bjk110 イメージ用 (/opt/hpcx/... と dist-packages) で、上流
# イメージには HPC-X が無い。存在しないパスを足しても実害は無いが紛らわしいので
# 明示的に上書きする。NCCL は libibverbs 経由の native IB トランスポートで RoCE を
# 掴むので HPC-X の SHARP plugin は要らない (libibverbs-dev はイメージに入っている)。
VLLM_LD_LIBRARY_PATH_EXTRA=/usr/local/cuda/lib64:/usr/local/nvidia/lib64
NCCL_IB_DISABLE=0
NCCL_NVLS_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
# ハンドシェイクを追う時は INFO に上げる
NCCL_DEBUG=WARN
MAX_JOBS=4
