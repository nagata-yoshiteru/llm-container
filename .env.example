# =============================================================================
# dealignai/GLM-5.3-Flash-UNCENSORED-FP8 / 4x DGX Spark (GB10) — 共通 .env
#
#   cp .env.example .env    # IP を実機に合わせて書き換える
#
# 4 台とも同じ内容を置く (head で作って scp で配るのが楽)。
# head / worker1..3 の違いは compose の --profile だけ (NODE_RANK は compose が入れる)。
# `sudo docker compose` から読まれるので ${HOME} 等のシェル変数は使えない。
#
# -----------------------------------------------------------------------------
# 起動 (worker3 -> worker2 -> worker1 -> head の順。head が rendezvous の master)
#
#   ssh -t <worker3> 'cd ~/repos/llm-container && sudo docker compose --profile worker3 up -d'
#   ssh -t <worker2> 'cd ~/repos/llm-container && sudo docker compose --profile worker2 up -d'
#   ssh -t <worker1> 'cd ~/repos/llm-container && sudo docker compose --profile worker1 up -d'
#   sudo docker compose --profile head up -d
#
#   API は head の ${HOST_PORT} に 1 本だけ生える (OpenAI 互換)。
#     curl -s http://192.168.0.1:8910/v1/models
#
#   4 台とも ./scripts/preflight.sh を通してから起動すること。
# =============================================================================

# -----------------------------------------------------------------------------
# イメージ (digest 固定 / linux-arm64)
#
#   v8 = day-0 公式イメージ vllm/vllm-openai:glm53-flash に SM121 向けパッチを
#   載せたもの。SM121 で glm5_next を動かすための必須パッチが入っている:
#     - SM90 NoPE-MLA バックエンドを SM121 で有効化 (FA2)
#     - FlashInfer 0.6.18 (0.6.17 は 64〜256 行バッチで NaN)
#     - NCCL 2.30.7 固定 / cutlass-dsl 4.6.2 / PDL を SM12x で無効
#     - indexer 強化 / fp8 KV 対応
#
#   ★ 素の vllm は GB10 で glm5_next が動かない (NoPE MLA: head_dim=0 に対して
#     標準 SM12x sparse カーネルが DeepSeek の pe_dim=64 を要求して assert)。
#     上の SM121 パッチが焼かれていないイメージを使うと、起動時に落ちる。
# -----------------------------------------------------------------------------
VLLM_IMAGE=ghcr.io/tonyd2wild/vllm-glm53-flash@sha256:d77d375c742fc54f436dec5108b440f58f021bc6600052bf0e8fe5840357e78f

# -----------------------------------------------------------------------------
# モデル (4 台とも同じ相対/絶対パスに置くこと / 62 shard / 約 328GB = 306GiB)
#
#   ./scripts/fetch-model.sh  がこのパスに落とす。
#   MTP の draft head (num_nextn_predict_layers=1) は同じ shard 群に入っている
#   ので、DeepSeek と違い別ファイルは要らない。
# -----------------------------------------------------------------------------
MODEL_PATH=./models/GLM-5.3-Flash-UNCENSORED-FP8
MODEL_CONTAINER_PATH=/models/GLM-5.3-Flash-UNCENSORED-FP8
SERVED_MODEL_NAME=glm-5.3-flash-uncensored glm-5.3-flash

# -----------------------------------------------------------------------------
# トポロジ (TP=4 / 4 ノード)
#
#   モデルカードの推奨と同じ --tensor-parallel-size 4。glm5_next の形状は
#   4 で全部割り切れる (heads 64→16 / KDA 64→16 / vocab 154880→38720 /
#   moe_intermediate 2048→512 / intermediate 12288→3072)。
#   3 台では TP=3 が割り切れず assert、DP3/EP3 は重み 111GiB/rank で起動時の
#   空き 109.3GiB に載らなかった (2026-10-06)。PP は glm5_next では vllm 側で
#   ゲートされている。
#
#   ネットワークは光スイッチ経由のフルメッシュ (同一 L2)。RING ではないので
#   ノードごとにポート名を差し替える必要は無い (4 台とも f0 系をスイッチへ)。
#
#   レールごとにサブネットを分ける (192.168.0.0/24 = rail0, 192.168.1.0/24 = rail1)
#   node_rank 0..3 = head / worker1 / worker2 / worker3 = 第 4 オクテット .1〜.4
#   ★ 実際の割り当てはこの機体の netplan に合わせて書き換えること。
#   ★ HEAD_ROCE_IP が rendezvous (MASTER_ADDR)。worker はここに繋ぎに行く。
# -----------------------------------------------------------------------------
TP_SIZE=4
NNODES=4
MASTER_PORT=29501

HEAD_ROCE_IP=192.168.0.1
WORKER1_ROCE_IP=192.168.0.2
WORKER2_ROCE_IP=192.168.0.3
WORKER3_ROCE_IP=192.168.0.4

# -----------------------------------------------------------------------------
# RoCE / NIC
#   光スイッチはジャンボを通さない (MTU 1500 / RoCE active_mtu 1024)。
#   4 台とも f0 系 2 ポートをスイッチに挿している前提。f1 系は未結線で DOWN。
#   ★ 同一 L2 に複数 NIC があるので arp_ignore=1 / arp_announce=2 が必須
#     (でないと rail0 宛の ARP に rail1 の MAC が答え、RoCE が別 HCA に着いて
#      無言ハングする)。4 台とも設定済みか preflight で確認すること。
#   ★ dual-HCA では NCCL_IB_GID_INDEX を必ず空にする (index がずれると無言ハング)。
# -----------------------------------------------------------------------------
ROCE_IF_NAME=enp1s0f0np0,enP2p1s0f0np0
IB_HCA_NAME=rocep1s0f0,roceP2p1s0f0
NCCL_IB_MERGE_NICS=1
NCCL_CROSS_NIC=1
NCCL_IB_GID_INDEX=
# office LAN に流れないよう RoCE のレールを IPv4 で固定する。
NCCL_NET=IB
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_IB_ADDR_RANGE=192.168.0.0/24

# -----------------------------------------------------------------------------
# コンテキスト / メモリ
#
#   重み (shard ヘッダの実測、vision は --language-model-only で載せない):
#     (305.8GiB - vision 1.05GiB) / 4 = 約 76.2GiB/rank
#   CUDA ctx / NCCL / プロセスで +7GiB 前後。残りが KV / アクティベーション。
#
#   GPU_MEMORY_UTILIZATION は「起動時の空き / 119.63GiB」を超えると即落ちる:
#     ValueError: Free memory on device cuda:0 (109.32/119.63 GiB) on startup is
#     less than desired GPU memory utilization (0.92, 110.06 GiB)
#   GB10 では OS 等で常時 ~10GiB 使われているので、上限は実質 0.91。
#   0.88 (= 105.3GiB) なら KV に ~20GiB/rank 回る。4 台のうち空きが一番少ない
#   ノードに合わせること (全 rank 同じ値が渡る)。preflight が確認する。
#
#   MAX_MODEL_LEN=262144 は NVFP4 TP2 レシピの検証値。MLA の KV は fp8 で
#   1 トークン数 KB なので、20GiB あれば 1 本の長文には十分。
#   MAX_NUM_BATCHED_TOKENS=4608 (= 2304 x 2) : 1 step の prefill 予算。
#   prefill のチャンク境界は KDA の state checkpoint のため block (2304) の倍数に
#   切り下げられる (vLLM Scheduler._mamba_block_aligned_split):
#     空 (MTP 込みで 2048) -> 2048, 256, 2048, 256 ... (平均 1152/step)
#     4096                 -> 2304 ずつ (4096 の残りは捨てられる)
#     4608                 -> 4608 ずつ
#   なので 2304 の倍数にする。4x Spark TP4 の上流は 4096〜6919 で運用。
# -----------------------------------------------------------------------------
HOST_PORT=8910
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=6
MAX_NUM_BATCHED_TOKENS=4608
GPU_MEMORY_UTILIZATION=0.88

# -----------------------------------------------------------------------------
# vLLM 引数は 3 つに分けてある。entrypoint がこの順で `vllm serve` に渡す。
# JSON 値の中に空白を入れないこと (空白で分割しているため)。
#   VLLM_PARSER_ARGS : パーサ類
#   VLLM_KV_ARGS     : KV 関連
#   VLLM_EXTRA_ARGS  : 量子化 / moe-backend / speculative / その他
# -----------------------------------------------------------------------------

# --reasoning-parser glm45 : thinking を `reasoning` フィールドに分離する。
#                            外すと思考が content に混ざる。
# --tool-call-parser glm47 : ツール呼び出しの構造化 (glm47 = GLM-4.7 系シンタックス)。
# --enable-auto-tool-choice : 必須 (Claude Code 等は tool_choice="auto" を送る)。
VLLM_PARSER_ARGS=--tool-call-parser glm47 --enable-auto-tool-choice --reasoning-parser glm45

# --block-size 2304 : この backend では kpool(4)x64=256 と MLA の 128 アライン
#                    の両方の倍数でなければならない (2304 = 256x9 = 128x18)。
#                    変更すると DeepGEMM assert で起動不能になる。
# --kv-cache-dtype fp8_e4m3 : SM121 向けにパッチ済み (v8)。bf16 の 2 倍入る。
# --kv-cache-memory-bytes は **固定しない**。GB10 ドライバの割当は MemAvailable
#   ではなく MemFree を見るため、プロファイラの建議値より大きく固定すると
#   warmup で NVRM OOM する (上流 6 回の boot で実証)。
VLLM_KV_ARGS=--kv-cache-dtype fp8_e4m3 --block-size 2304

# --speculative-config : チェックポイント同梱の MTP head (mtp.*)。
#                        card の推奨は num_speculative_tokens=1。この機体の
#                        head は accept 率が高いので 3 まで上げてよいが、
#                        draft 分だけメモリを食う。メモリが足りなければこの
#                        オプションごと削って ~2GiB/rank 解放する。
# --moe-backend : 既定では付けない (vllm に選ばせる)。SM121 (sm_121a) では
#                DeepGEMM / CUTLASS の block-FP8 MoE が対象外なので、おそらく
#                Triton の fused_moe が選ばれる。その tile 設定は GB10 / E=288 /
#                N=512 用のものを patches/moe-configs/ に置いてあり、compose が
#                VLLM_TUNED_CONFIG_FOLDER で読ませる (vLLM 同梱は E=256/512 だけ)。
#                選択に失敗する / 出力が壊れる
#                場合は `--moe-backend marlin` (FP8 W8A16) か `triton` を明示する。
#                ★ 選んだ backend は起動ログの "Using ... MoE backend" で必ず確認。
# --compilation-config : torch.compile は使わず (mode 0)、decode だけ CUDA graph
#                (FULL_DECODE_ONLY)。MTP k=1 だと 1 seq の decode は 2 トークンなので、
#                サイズは 2 の倍数 (vLLM が自動で丸める)。MAX_NUM_SEQS=6 x 2 = 12 まで。
#                MAX_NUM_SEQS か num_speculative_tokens を変えたらここも合わせる。
#                JSON の中に空白を入れないこと (entrypoint が空白で分割する)。
VLLM_EXTRA_ARGS=--speculative-config {"method":"mtp","num_speculative_tokens":1} --compilation-config {"mode":0,"cudagraph_mode":"FULL_DECODE_ONLY","cudagraph_capture_sizes":[2,4,6,8,10,12],"max_cudagraph_capture_size":12}

# -----------------------------------------------------------------------------
# entrypoint が条件付きでフラグに変換するスイッチ
#
#   LANGUAGE_MODEL_ONLY=1 : text-only サーバ。vision tower を積まない。
#     - メモリを ~1.2GiB/rank 節約する
#     - SM12x の sparse-MLA prefill には画像幅のカーネルが無い (NVFP4 レシピで
#       overlay が max_image_tokens=0 に pin していたのと同じ問題)
#     画像も使いたい場合は 0 にして、LIMIT_MM={"image":2} と
#     SKIP_MM_PROFILING=1 を併用する。ただしメモリはさらに苦しくなる。
#   ENFORCE_EAGER=0 : CUDA graph を使う。graph の形は VLLM_EXTRA_ARGS の
#                     --compilation-config で decode だけに絞っている。
#                     「graph capture 不可」は v8 / TP2 時代の古い知見で、4x Spark
#                     TP4 の上流は FULL_DECODE_ONLY で運用している。capture で
#                     落ちたら 1 に戻し、--compilation-config も外すこと。
#   SKIP_MM_PROFILING / LIMIT_MM は vision ON のときだけ意味がある。
# -----------------------------------------------------------------------------
LANGUAGE_MODEL_ONLY=1
ENFORCE_EAGER=0
SKIP_MM_PROFILING=
LIMIT_MM=

# -----------------------------------------------------------------------------
# SM121 数値契約 / ランタイム
#   FLASHINFER_DISABLE_VERSION_CHECK=1 : 上流レシピの値。
#   VLLM_ENGINE_READY_TIMEOUT_S=3600 : 306GiB (1 台 76GiB) のロード + JIT に 1 時間許す。
#     これを設定しないと、ロード中の長い無音を「死んだ」と判定されて落ちる。
#   MAX_JOBS=4 : ランタイム JIT が nproc 分の nvcc を撒いて UMA を食い潰すのを防ぐ。
# -----------------------------------------------------------------------------
FLASHINFER_CUDA_ARCH_LIST=12.1a
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_DISABLE_VERSION_CHECK=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
VLLM_ENGINE_READY_TIMEOUT_S=3600
VLLM_LD_LIBRARY_PATH_EXTRA=/usr/local/cuda/lib64:/usr/local/nvidia/lib64
VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256

# -----------------------------------------------------------------------------
# NCCL / ランタイム基盤
#   UMA 向けバッファ調整 (ネイティブ DS4.1 3-Spark recipe 由来)。
#   VLLM_NCCL_SO_PATH は空のまま (イメージ内 torch 同梱の NCCL を使う)。
# -----------------------------------------------------------------------------
NCCL_IB_DISABLE=0
NCCL_NVLS_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_CUMEM_ENABLE=0
NCCL_BUFFSIZE=1048576
NCCL_LL128_BUFFSIZE=262144
NCCL_PROTO=^LL128
NCCL_MAX_NCHANNELS=8
# TP の all-reduce が毎層 4 ノードをまたぐ。ハンドシェイクを追う時は INFO に上げる。
NCCL_DEBUG=WARN
TORCH_NCCL_ASYNC_ERROR_HANDLING=1
MAX_JOBS=4
