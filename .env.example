# =============================================================================
# RedHatAI/GLM-5.3-Flash-NVFP4 + DFlash2 / 2x DGX Spark (GB10) — 共通 .env
#
#   cp .env.example .env して、トポロジの値を自分の環境に合わせる。
#
# 2 台とも「同じ内容」を置く。役割は compose の --profile で切り替える。
# head と worker で相手を向いているポート名が違う場合は、worker 側は
# WORKER_ROCE_IF_NAME / WORKER_IB_HCA_NAME で差し替える (compose が見る)。
#
# `sudo docker compose` から読まれるので ${HOME} 等のシェル変数は使えない。
#
# -----------------------------------------------------------------------------
# 起動 (worker -> head の順)。
# 片方だけ違う --env-file 組み合わせで起動すると rendezvous で死ぬ。
#
#   ssh -t <worker の管理 IP> 'cd ~/repos/llm-container && sudo docker compose \
#     --profile worker up -d'
#
#   sudo docker compose --profile head up -d
#
# 既定は v11-dflash2 イメージ + DFlash2 k=7 + KV 8 GiB 固定 (上流 2026-09-18
# レシピ)。MTP-4 に戻すなら presets/mtp4.env を重ねる。
# =============================================================================

# イメージ (digest 固定 / linux-arm64 / day-0 公式 + SM121 パッチ 8 段 + DFlash2)
# 素の vLLM では GB10 で glm5_next が起動しない (NoPE MLA の assert)。
# タグ表記では ghcr.io/tonyd2wild/vllm-glm53-flash:sm121-v11-dflash2 と同じもの。
VLLM_IMAGE=ghcr.io/tonyd2wild/vllm-glm53-flash@sha256:4def0ef644cb2e9814136dcffd5e385e21bc594f48f3b292234051904abe85a6

# モデル (2 台とも同じパス / 約 198GB・10 shard + model_mtp.safetensors)
#   ./scripts/fetch-model.sh がこのパスにダウンロードする
#
# ModelOpt 量子化の NVFP4 (LibertAIDAI / abliterated 系) は token を壊すので使わない
# (vLLM #54150 / Hangul プローブで U+FFFD 4,9,8 個 vs RedHatAI 0,0,0)。英文では
# ほぼ見えないが tool-call ブロックの中で壊れると parser が desync する。
# preflight が config.json の quant_method を見て弾く。
MODEL_PATH=./models/GLM-5.3-Flash-NVFP4
MODEL_CONTAINER_PATH=/models/GLM-5.3-Flash-NVFP4
SERVED_MODEL_NAME=glm-5.3-flash

# DFlash2 drafter (既定レシピで必須 / 約 2.2GB)
#   ./scripts/fetch-model.sh draft で取得
#   ライセンス CC-BY-NC-ND-4.0 (非商用・改変禁止)
DRAFT_PATH=./models/GLM-5.3-Flash-DFlash2

# -----------------------------------------------------------------------------
# トポロジ / ネットワーク
#
#   head と worker の QSFP (RoCE) 側 IP / IF 名 / HCA 名 / GID index を入れる。
#   確認方法:
#     ip -br addr show <IF>        # RoCE 側の IPv4
#     show_gids                    # その IPv4 が載る行の DEV / INDEX (RoCE v2 の方)
#   Spark は RoCE ポートを 2 本見せるがケーブルが刺さっているのは 1 本だけ。
#   刺さっていない側の GID index 3 は空なので、必ずケーブル側の HCA に固定する。
#   QSFP 側は link-local で再起動すると IP が変わることがある (preflight 検出)。
# -----------------------------------------------------------------------------
TP_SIZE=2
NNODES=2
MASTER_PORT=29501

HEAD_ROCE_IP=
WORKER_ROCE_IP=

ROCE_IF_NAME=
IB_HCA_NAME=
NCCL_IB_GID_INDEX=3

# worker 側だけ別ポートを向いている場合の上書き (未設定なら head と同じ値)
WORKER_ROCE_IF_NAME=
WORKER_IB_HCA_NAME=
WORKER_NCCL_IB_GID_INDEX=

# API ポート (OpenAI 互換)
HOST_PORT=8910

# -----------------------------------------------------------------------------
# コンテキスト / メモリ
#
#   TP2 で検証されているコンテキストは 262,144 (ネイティブ上限は 1M だが
#   TP2 の KV プールでは 1M 単一リクエストは載らない)。上げないこと。
#
#   KV_CACHE_MEMORY は 8 GiB に固定する (上流 2026-09-18 で方針転換)。
#   プロファイラ任せより KV プールが 33% 増える。ただし固定すると vLLM は
#   メモリプロファイリングを丸ごとスキップするので、MAX_NUM_BATCHED_TOKENS の
#   活性化ピークを誰も検証しない。**8192 を超えないこと** (16384 は両ノードで
#   NVRM NV_ERR_NO_MEMORY / entrypoint と preflight が弾く)。
#
#   これは boot hardening (MAX_JOBS=2 / 永続 JIT キャッシュ / MEM_LIMIT /
#   scripts/flusher.sh) が入っている前提の値。hardening 抜きで固定すると
#   旧 README のラダー通り warmup で落ちる。README「KV は 8 GiB に固定する」参照。
#
#   OOM が出るなら 6442450944 (6 GiB) に落とす。0 か空でプロファイラ任せに戻る。
# -----------------------------------------------------------------------------
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=6
MAX_NUM_BATCHED_TOKENS=8192
GPU_MEMORY_UTILIZATION=0.85
KV_CACHE_MEMORY=8589934592

# コンテナの cgroup メモリ上限。超過を「ホストごと巻き込む page-allocator
# livelock + watchdog リブート」ではなく「コンテナの clean な OOM」にする。
# UMA の GPU 割当は cgroup に課金されないので、これはホスト側だけを縛る。
MEM_LIMIT=112g

# -----------------------------------------------------------------------------
# vLLM 引数 (JSON 値の中に空白を入れないこと)
# -----------------------------------------------------------------------------
VLLM_PARSER_ARGS=--tool-call-parser glm47 --enable-auto-tool-choice --reasoning-parser glm45 --enable-prompt-tokens-details
VLLM_KV_ARGS=--kv-cache-dtype fp8_e4m3 --block-size 2304

# DFlash2 k=7 は drafter の block_size 8 - 1 で固定。8 にするとモデルが学習して
# いない位置を draft する。深い並行性を狙うなら presets/deep-concurrency.env。
VLLM_EXTRA_ARGS=--moe-backend marlin --enforce-eager --speculative-config {"method":"dflash","model":"/models/GLM-5.3-Flash-DFlash2","num_speculative_tokens":7}

# マルチモーダル。image を 2 枚に上げる。video を 0 にすると起動時の
# 最大サイズ video encoder profile をスキップできる (上流の既定 / 2026-09-18 の
# メモリ事故対策) が、ここでは動画入力を残すため 1 のまま。
VLLM_MM_ARGS=--limit-mm-per-prompt {"image":2,"video":1}

# chat template の既定 kwargs。空のままにする。
#   enable_thinking:false は DFlash2 acceptance が +8% になるが、thinking が
#   タグなしで content に出るので --reasoning-parser glm45 が効かなくなる。
#   速度優先で切るなら presets/thinking-off.env を重ねる。
#
# --chat-template は渡さない。checkpoint 同梱の chat_template.jinja が
# image/video/audio の placeholder マクロと tool_call ID 重複判定を持つ最新版で、
# 上流 repo の chat_template_mm.jinja より新しい。
VLLM_CHAT_TEMPLATE_ARGS=

# -----------------------------------------------------------------------------
# 任意パッチ (entrypoint が /patches から site-packages にコピーする)
#
#   PREFIX_FIX=1 : #18 prefix-cache 修正。公開イメージ sm121-v11-dflash2 は
#     2026-08-28 ビルドでこの修正を持たないため、エージェントのセッションが
#     毎ターン会話全体を再 prefill する。13K トークン反復の TTFT 21.1s -> 6.3s。
#     ./scripts/build-prefix-fix.sh で
#     patches/kv_cache_coordinator_prefix_fix.py を生成してから有効になる
#     (未生成なら自動で OFF / 起動ログに理由が出る)。
#
#   ROCE=1 : b12x RoCEnante one-shot RoCE all-reduce。aggregate +5〜18%。
#     patches/roce/ に b12x ランタイムを揃える必要がある
#     (./scripts/build-roce-bundle.sh / patches/roce/README.md)。
#     既定 OFF。有効化は presets/roce.env を重ねる。
# -----------------------------------------------------------------------------
PREFIX_FIX=1
ROCE=0

# -----------------------------------------------------------------------------
# SM121 数値契約 / NCCL (RoCEv2 固定)
#   NCCL_IB_ADDR_RANGE は RoCE サブネット (x.x.x.0/24) を入れる。
# -----------------------------------------------------------------------------
FLASHINFER_CUDA_ARCH_LIST=12.1a
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_DISABLE_VERSION_CHECK=1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
VLLM_ENGINE_READY_TIMEOUT_S=3600

NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_IB_ADDR_RANGE=
NCCL_CROSS_NIC=0
NCCL_IB_MERGE_NICS=0
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_NVLS_ENABLE=0
NCCL_DEBUG=WARN
TORCH_NCCL_ASYNC_ERROR_HANDLING=1

# -----------------------------------------------------------------------------
# boot hardening (JIT storm 対策 / 上流 2026-09-18 の §3)
#
#   既定の MAX_JOBS だと FlashInfer が CPU 数ぶんの nvcc を撒き、重みが既に
#   常駐している状態で cicc が OOM killer を呼ぶ。128GB unified memory では致命的。
#   永続キャッシュ側は compose が ./vllm-cache/{flashinfer,tilelang,triton} に
#   マウントするので、fp4 CUTLASS GEMM の variant は 1 回しかコンパイルされない
#   (初回 boot 41 分 -> 以降 16〜19 分)。
# -----------------------------------------------------------------------------
MAX_JOBS=2
FLASHINFER_NVCC_THREADS=1
