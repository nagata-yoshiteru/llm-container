# DeepSeek V4.1-1017 UNCENSORED native FP8 + FP4 / 3 DGX Spark RING.
# Shared on all hosts; select head / worker1 / worker2 with Compose profiles.
SGLANG_IMAGE=llm-deepseek41-sglang:tp3-1017-v1
MODEL_REPO=dealignai/DeepSeek-V4.1-Flash-1017-UNCENSORED-FP8
MODEL_REVISION=c19ca5ca4eaeb79d29fdf08aea8327da95b1116a
MODEL_PATH=./models/DeepSeek-V4.1-Flash-1017-UNCENSORED-FP8
MODEL_CONTAINER_PATH=/models/DeepSeek-V4.1-Flash-1017-UNCENSORED-FP8
# Local, rank-specific packed Engram rows. Never reuse another checkpoint's pack.
ENGRAM_PATH=./models/DeepSeek-V4.1-Flash-1017-UNCENSORED-FP8-engram-tp3
SERVED_MODEL_NAME=deepseek-v4.1-flash-1017-uncensored
HOST_PORT=8910
DIST_PORT=20000
NNODES=3
TP_SIZE=3
EP_SIZE=1

# Management LAN for rendezvous and Gloo. DHCP: verify before every rollout.
HEAD_NODE_IP=192.168.aaa.xxx
WORKER1_NODE_IP=192.168.aaa.yyy
WORKER2_NODE_IP=192.168.aaa.zzz
NCCL_SOCKET_IFNAME=enP7s7
GLOO_SOCKET_IFNAME=enP7s7
# Three direct cables, two PCI domains per cable, MTU 9000:
# head f1 -- worker1 f0: 192.168.0.0/24 + 192.168.1.0/24
# worker1 f1 -- worker2 f0: 192.168.2.0/24 + 192.168.3.0/24
# worker2 f1 -- head f0: 192.168.4.0/24 + 192.168.5.0/24
# Host suffix: head=.1 / worker1=.2 / worker2=.3
ROCE_IF_NAME=enp1s0f0np0,enP2p1s0f0np0,enp1s0f1np1,enP2p1s0f1np1
IB_HCA_NAME=rocep1s0f0,roceP2p1s0f0,rocep1s0f1,roceP2p1s0f1
# Empty = discover a valid common IPv4 RoCEv2 index separately on each host.
NCCL_IB_GID_INDEX=
NCCL_IB_ADDR_RANGE=192.168.0.0/21
NCCL_BUFFSIZE=1048576
NCCL_LL128_BUFFSIZE=262144
NCCL_PROTO=^LL128
# Reduce RDMA registration/buffer pressure on shared CPU/GPU memory.
NCCL_MAX_NCHANNELS=4
NCCL_DEBUG=INFO

# RAM is shared by CPU/GPU: never put the ~189 GiB Engram tables in RAM.
OFFLOAD_MODE=nvme
DSV41_CACHE_GIB=0
DSV41_RESIDENT_SCALES=0
DSV41_IO_THREADS=96
DSV41_TP_PAD=1
# Conservative initial envelope. GPU boot/quality/long context remain untested here.
CONTEXT_LENGTH=32768
MAX_TOTAL_TOKENS=131072
MAX_RUNNING_REQUESTS=2
CHUNKED_PREFILL_SIZE=512
MEM_FRACTION_STATIC=0.95
SPEC_ALGO=DSPARK
DSPARK_BLOCK_SIZE=3
DSV41_VERIFY_CAP=0
# These release BF16 projection copies to preserve the TP3 memory margin.
DSV41_WO_A_W8=1
DSV41_WO_A_W8_MID=1
DSV41_WO_A_W8_DROP=1
DSV41_DRAFT_HEAD_FP8=1
DSV41_ENGRAM_PREFETCH=1
DSV41_PREFILL_EMPTY_CACHE_TOKENS=8192
DSV41_MAX_NEW_TOKENS=16384
MAX_JOBS=4
