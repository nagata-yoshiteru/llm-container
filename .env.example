# =============================================================================
# MiniMax-M3 (NVFP4) on 3x NVIDIA DGX Spark (GB10 / SM121)
#
#   PP=3 / TP=1 (1 GPU/node) / distributed-executor-backend = ray
#   NCCL データ面 = 200G QSFP の三角メッシュ (RoCEv2)
#   Ray と NCCL bootstrap = 10GbE 管理 NIC
#
# 3 台とも同じ .env を置く。役割は compose の --profile で切り替える。
# `sudo docker compose` から読まれるので ${HOME} 等のシェル変数は使えない。
# =============================================================================

# -----------------------------------------------------------------------------
# イメージ
#   vLLM 公式 nightly (linux-arm64) を digest 固定。
#   NGC (nvcr.io/nvidia/vllm) は最新の 26.07-py3 でも中身が 2026-06-17 で、
#   M3 の pipeline parallelism 対応 (2026-06-24) に届かないため使えない。
#   Dockerfile で ray と NCCL 2.30.7 を足している。
# -----------------------------------------------------------------------------
VLLM_BASE_IMAGE=vllm/vllm-openai@sha256:5ee06541ff9fbd220c0a8f51608e72ea0da8d1a71ebf812af7d7c6b5a1aebbb7
VLLM_IMAGE=llm-container/vllm-m3:upstream-20260808

# -----------------------------------------------------------------------------
# モデル (3 台とも同じ絶対パスに / 250GB・88 shard)
#
#   重みはイメージと組で選ぶこと。M3 の MSA indexer には実装が 2 系統あり、重みの
#   命名が割れている。upstream vLLM は indexer を qkv に畳む fused 実装なので
#   `self_attn.index_k_proj` 命名の nvidia 版が正しい。非 fused 実装用の
#   lukealonso 版 (`self_attn.indexer.k_proj`) を渡すと
#   `Shard id for QKVParallelLinear ... got shard id index_k` で落ちる。
# -----------------------------------------------------------------------------
MODEL_PATH=./models/MiniMax-M3-NVFP4
MODEL_CONTAINER_PATH=/models/MiniMax-M3-NVFP4
SERVED_MODEL_NAME=minimax-m3

# -----------------------------------------------------------------------------
# トポロジ
#   TP=3 は使えない。M3 は num_key_value_heads=4 で、vLLM は kv_heads と TP の
#   どちらかがもう一方で割り切れることを要求するため。PP=3 なら 60 layer / 3 = 20。
#   ステージ順は物理リングと一致させてある (rank0 -> rank1 -> rank2)。
# -----------------------------------------------------------------------------
TP_SIZE=1
PP_SIZE=3
NNODES=3
DIST_BACKEND=ray
RAY_PORT=6379

# -----------------------------------------------------------------------------
# ネットワーク
#   Ray と NCCL bootstrap は全ノードが到達できる 10GbE を通す。RoCE は各ノードが
#   2 つの隣人としか繋がっていないので制御面には使えない。
# -----------------------------------------------------------------------------
OOB_IF_NAME=enP7s7

# head を動かす機体を NODE0 にする
NODE0_MGMT_IP=192.168.aaa.xxx
NODE1_MGMT_IP=192.168.aaa.yyy
NODE2_MGMT_IP=192.168.aaa.zzz

HOST_PORT=8910
MASTER_PORT=29501

# -----------------------------------------------------------------------------
# NCCL / RoCE — 3 ノードメッシュ用 (2 ノード直結とは設定が別物)
#
#   NCCL_IB_GID_INDEX は【設定しない】。固定すると subnet-aware routing が無効になり、
#   隣人ごとに正しい GID を選べず ibv_modify_qp err 110 で死ぬ。
#   代わりに NCCL_IB_ADDR_RANGE の CIDR から NCCL に選ばせる。
#
#   NCCL_CROSS_NIC=1 は必須。各ノードで f0 が向いている隣人が違う非対称配線なので、
#   既定の「同 index の NIC 同士をペア」だと未接続のサブネットにダイヤルする。
#
#   NCCL_IB_HCA は slot-1 側の 2 本だけ。twin を含む 4 本にすると
#   ペアリングの組み合わせが倍になり err 110 を踏みやすい。
# -----------------------------------------------------------------------------
NCCL_IB_HCA=rocep1s0f0,rocep1s0f1
NCCL_IB_ADDR_RANGE=192.168.0.0/21
NCCL_IB_DISABLE=0
NCCL_NET=IB
NCCL_IB_MERGE_NICS=0
NCCL_NET_PLUGIN=none
NCCL_IB_SUBNET_AWARE_ROUTING=1
NCCL_CROSS_NIC=1
NCCL_IB_ADDR_FAMILY=AF_INET
NCCL_IB_ROCE_VERSION_NUM=2
NCCL_NET_GDR_LEVEL=LOC
NCCL_CUMEM_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_NVLS_ENABLE=0
NCCL_DEBUG=WARN

# -----------------------------------------------------------------------------
# コンテキスト / メモリ
#
#   GPU_MEMORY_UTILIZATION は「予算 = util x MemTotal(119.63GiB)」を決めるだけで、
#   増えるのは KV プールのみ。decode 速度には効かない (帯域律速のため)。
#   head は API サーバと Ray head を抱えるぶん free が 104.66GiB しかないので
#   0.875 が絶対の天井。GB10 は UMA なので超過すると OOM-kill でノードごと落ちる。
#
#   MAX_NUM_BATCHED_TOKENS が prefill 中の活性化メモリを決める。
#   OOM-kill (exit 137) されたらまずここを下げる。
#
#   KV サイズを固定したいなら VLLM_KV_ARGS に `--kv-cache-memory <bytes>` を足す
#   (指定すると GPU_MEMORY_UTILIZATION は無視される)。起動ログが推奨値を出す。
# -----------------------------------------------------------------------------
MAX_MODEL_LEN=262144
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=4096
GPU_MEMORY_UTILIZATION=0.85

# -----------------------------------------------------------------------------
# vLLM 引数。entrypoint がこの順で `vllm serve` に渡す。
# JSON 値の中に空白を入れないこと (空白で分割しているため)。
# -----------------------------------------------------------------------------

# nvidia 版は config.json から modelopt が自動検出される
VLLM_QUANT_ARGS=

# 外すと thinking が content に混ざり、tool_call タグも生で漏れる
VLLM_PARSER_ARGS=--reasoning-parser minimax_m3 --tool-call-parser minimax_m3 --enable-auto-tool-choice

# --block-size 128 : M3 の sparse_block_size が 128。変えると attention が壊れる
VLLM_KV_ARGS=--kv-cache-dtype fp8 --block-size 128

# --attention-backend TRITON_ATTN : GB10 では必須。M3 は先頭 3 層が full attention、
#     残りが MSA の混成で、MSA 側は block size 128 しか受けない。full attention 側で
#     既定選択される FlashInfer は 128 以上を sm_100 系 (B200/GB200) でしか
#     advertise しないため sm_121 では共通解が無くなり
#     `No common block size for 128` で落ちる。TRITON_ATTN は MultipleOf(16)。
# --load-format safetensors : 既定の auto は GDS 経路を試して Spark で失敗する報告あり
# --skip-mm-profiling : テキスト用途なので vision タワーのプロファイルを飛ばす
VLLM_EXTRA_ARGS=--attention-backend TRITON_ATTN --load-format safetensors --enable-chunked-prefill --enable-prefix-caching --skip-mm-profiling

# -----------------------------------------------------------------------------
# ランタイム (GB10 = sm_121)
# -----------------------------------------------------------------------------
TORCH_CUDA_ARCH_LIST=12.1a
FLASHINFER_CUDA_ARCH_LIST=12.1
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
SAFETENSORS_FAST_GPU=1

# -----------------------------------------------------------------------------
# Ray
#   memory monitor は重みロード直後の rank0 を誤検知 kill するので切る。
#   object store は既定で約 36GB/node を予約してしまうので 1GiB に絞る。
#   RAY_INCLUDE_DASHBOARD=0 にすると head の余裕が少し増える。
# -----------------------------------------------------------------------------
RAY_memory_monitor_refresh_ms=0
RAY_DEDUP_LOGS=0
RAY_OBJECT_STORE_MEMORY=1073741824
RAY_INCLUDE_DASHBOARD=1

MAX_JOBS=4
