# =============================================================================
# deepseek-ai/DeepSeek-V4.1-Flash (EXL3 2.9bpw) / 2x DGX Spark (GB10) — 共通 .env
#
#   cp .env.example .env
#
# 2 台とも同じ内容を置く。head / worker の違いは compose の --profile だけ。
# `sudo docker compose` から読まれるので ${HOME} 等のシェル変数は使えない。
#
# 出典レシピ: https://github.com/MiaAI-Lab/DeepSeek-v4.1-Flash-EXL3-2x-DGX-Sparks
#   向こうは start.sh + NFS share で運用する構成。この repo では
#   「2 台ローカルに重みを置く + docker compose + entrypoint.sh」に読み替えている。
#   読み替えの対応表だけ覚えておくと上流の docs が引ける:
#     IMAGE                       -> VLLM_IMAGE (digest 固定)
#     PORT=8888                   -> HOST_PORT (この repo の慣習で 8910 のまま)
#     MODEL_HOST / ENGRAM_DIR     -> MODEL_PATH / ENGRAM_PATH
#     start.sh の docker run 引数 -> scripts/entrypoint.sh + VLLM_*_ARGS
#     WEIGHT_SYNC=nfs (既定)      -> 不使用。2 台それぞれ ./scripts/fetch-model.sh
#     memguard / hang detector    -> 不使用 (--oom-score-adj 相当は compose 済み)
#
# 起動 (worker -> head の順):
#   ssh -t $WORKER 'cd ~/repos/llm-container && sudo docker compose --profile worker up -d'
#   sudo docker compose --profile head up -d
# =============================================================================

# -----------------------------------------------------------------------------
# イメージ (digest 固定 / linux-arm64)
#   ghcr.io/miaai-lab/deepseek-v4.1-flash-exl3-2x-dgx-sparks:2.9bpw
#   (= vllm/vllm-openai:deepseekv41-flash-0909 + ExLlamaV3 v1.4.5 overlay)
#   digest: sha256:2f0cf3adc0f989c1d446be274df864eb799630175f604c3b22b71b7205971dce
#
#   ★ Vision-Exp までと違い、SM121 用のパッチは全部このイメージに焼かれている:
#     E3 v2 grouped fat-expert kernels (mul1 K2/K3 用) /
#     patch_sm120_block64.py (64-token KV blocks + 画像 window 幅 1152 の回避) /
#     exllamav3 の lock buffer 1 台あたり 1 個化 / pinned H2D staging /
#     [dsv41-mem] ログと prefill 後の allocator 解放。
#     なので entrypoint 側の hotfix 適用 (旧 DSPARK_APPLY_HOTFIXES) は不要になった。
#   public なのでログイン不要。上流の build 機構 (BUILD=1 で Dockerfile ビルド) は
#   この repo では使わず、digest 固定で pull する。
# -----------------------------------------------------------------------------
VLLM_IMAGE=ghcr.io/miaai-lab/deepseek-v4.1-flash-exl3-2x-dgx-sparks@sha256:2f0cf3adc0f989c1d446be274df864eb799630175f604c3b22b71b7205971dce

# -----------------------------------------------------------------------------
# モデル (2 台とも同じ相対/絶対パスに置くこと)
#   scripts/fetch-model.sh        -> EXL3 ツリー (39 shard / 約 197GiB)
#                                    Mia-AiLab/DeepSeek-V4.1-Flash-EXL3-2.9bpw
#   scripts/fetch-model.sh engram -> ネイティブチェックポイント
#                                    deepseek-ai/DeepSeek-V4.1-Flash から
#                                    shard 47+48 + index + config.json だけ
#                                    (約 190GiB) を落とし、embed 専用の slim index
#                                    に置き換える (prepare-engram-src.py)。
#
#   ★ Engram テーブル (layers 1 と 14 の n-gram 埋込) だけ量子化されない。
#     EXL3 ツリーには入っていないので、ネイティブから別に用意して
#     --hf-overrides {"engram_table_dir":...} で教える。 rows は FP8
#     (fp8_e4m3fn)。uint8 として読むと Fluent な garbage が出る。
#   ★ ネイティブ 48 shard 全部 (約 476GiB) は要らない。47+48 だけ。
# -----------------------------------------------------------------------------
MODEL_PATH=./models/DeepSeek-V4.1-Flash-EXL3-2.9bpw
MODEL_CONTAINER_PATH=/models/DeepSeek-V4.1-Flash-EXL3
ENGRAM_PATH=./models/DeepSeek-V4.1-Flash-engram
ENGRAM_CONTAINER_PATH=/models/DeepSeek-V4.1-Flash-engram

# 空白区切りでエイリアスを並べられる (entrypoint が set -f して非クォート展開する)。
SERVED_MODEL_NAME=deepseek-v4.1-flash-exl3 deepseek-v4.1-flash

# -----------------------------------------------------------------------------
# トポロジ / ネットワーク
#   HEAD_ROCE_IP / WORKER_ROCE_IP は QSFP 直結リンク側の IP。
#   NVIDIA connect-two-sparks の netplan は link-local (169.254.x.x) を振るので、
#   再起動後に変わっていないか `ip -br addr show enp1s0f0np0` で確認すること。
#   IB_HCA_NAME は「ケーブルが刺さっている方」の HCA。`show_gids` で
#   IPv4 が上の IP になっている行の DEV 名と INDEX を読むこと。
#   出典レシピの配線は spark1 の f1 ↔ spark2 の f0。1 本直結で双方 f0 を
#   使っていれば WORKER_* は不要。リング配線で逆ポートを向いているときだけ設定。
# -----------------------------------------------------------------------------
TP_SIZE=2
NNODES=2
MASTER_PORT=29501

HEAD_ROCE_IP=169.254.xxx.xxx
WORKER_ROCE_IP=169.254.yyy.yyy
ROCE_IF_NAME=enp1s0f0np0
IB_HCA_NAME=rocep1s0f0
NCCL_IB_GID_INDEX=3

# QSFP をリング配線していて、worker 側が相手を向けているポートの名前が head と
# 違う場合だけ設定する。未設定なら上の値。
# WORKER_ROCE_IF_NAME=enp1s0f1np1
# WORKER_IB_HCA_NAME=rocep1s0f1
# WORKER_NCCL_IB_GID_INDEX=3

# -----------------------------------------------------------------------------
# dual-HCA (帯域をほぼ倍にする / 要ネットワーク作業)
#   手順・注意は README の「QSFP を 2 枚使う」。dual-HCA では
#   NCCL_IB_GID_INDEX を必ず空にすること (index がずれると無言ハング)。
# IB_HCA_NAME=rocep1s0f0,roceP2p1s0f0
# ROCE_IF_NAME=enp1s0f0np0,enP2p1s0f0np0
# NCCL_IB_MERGE_NICS=1
# NCCL_CROSS_NIC=1
# NCCL_IB_GID_INDEX=
# -----------------------------------------------------------------------------

HOST_PORT=8910

# -----------------------------------------------------------------------------
# コンテキスト / メモリ  (既定 = 600K。上流の実測値)
#
#   GB10 は unified memory なのですべての cudaMalloc が host RAM に commit される。
#   1 台あたりの内訳 (weight_budget.py --tp 2 の実測):
#     EXL3 重み        約 99.5 GiB   (TP2 で 197GiB を折って両ノード)
#     KV プール            2.5 GiB   (600K で 774,400 トークン入る / 約 3.4 KiB/token)
#     CUDA ctx/NCCL/graph  5〜7 GiB
#     vLLM プロセス/OS     約 9 GiB
#   121.7GiB に対して常時 MemAvailable 3.7〜4.7GiB で回る (601K prefill 後も 2.1GiB)。
#   ギリギリなので起動前に他ワークロードを止め、MemAvailable が 110GB 以上あることを
#   preflight で確認すること。
#
#   MAX_MODEL_LEN=600000 は 2x GB10 で検証済みの既定値 (上流)。
#   614,400 が実測天井。短くする分には自由。
#   MAX_NUM_SEQS=2 が検証済み上限 (4 にすると prefill 活性化で詰まりやすい)。
#   MAX_NUM_BATCHED_TOKENS=1536 は vision tower ON 時の下限 (画像 1024 token + 1)。
#   text-only (LANGUAGE_MODEL_ONLY=1) なら 1024 まで下げられる。
#   GPU_MEMORY_UTILIZATION は KV_CACHE を固定するので起動時の sanity check 相当。
#   0.92 は head で 20MB 足りて失敗した実例あり。0.88 推奨。
# -----------------------------------------------------------------------------
MAX_MODEL_LEN=600000
MAX_NUM_SEQS=2
MAX_NUM_BATCHED_TOKENS=1536
GPU_MEMORY_UTILIZATION=0.88

# -----------------------------------------------------------------------------
# vLLM 引数は 3 つに分けてある。entrypoint がこの順で `vllm serve` に渡す。
# JSON 値の中に空白を入れないこと (空白で分割しているため)。
#   VLLM_PARSER_ARGS : パーサ類。全構成共通
#   VLLM_KV_ARGS     : KV 関連
#   VLLM_EXTRA_ARGS  : その他 (quant / engram / dspark)
# -----------------------------------------------------------------------------

# deepseek_v41 はこのイメージに焼かれている tokenizer / tool-call / reasoning
# パーサ。外すと thinking が content に混ざる。thinking は `reasoning`
# フィールドに入る。
#
# reasoning effort (low/high/max) はサーバ側フラグではなくリクエストの
# chat_template_kwargs.reasoning_effort で渡す (既定 high=75 / low=50 / max=100)。
# sampling の公式既定は temperature=1.0 / top_p=0.95。
# thinking を消す smoke test は chat_template_kwargs {"enable_thinking":false}。
VLLM_PARSER_ARGS=--tokenizer-mode deepseek_v41 --tool-call-parser deepseek_v41 --reasoning-parser deepseek_v41

# -----------------------------------------------------------------------------
# ★ --kv-cache-dtype は渡さないこと。ネイティブ CSA2 KV (~890 B/token FP4) が
#   自動選択される。Vision-Exp/GLM までの fp8_ds_mla を手で指定すると壊れる
#   (上流 .env に "Do not set GLM's fp8_ds_mla here" の明記あり)。
#
#   --kv-cache-memory-bytes 2.5GiB : UMA では自動プロファイルが当てにならないので固定。
#       600K で 774,400 トークン (600K リクエスト 1 本 = 約 2.0GiB の 1.26 倍)。
#       1GiB (658K トークン) まで落とすと 4x128K がちょうど載る程度。
#   --block-size 64 : SM12x の DeepGEMM paged indexer kernel が 32 か 64 のみ。
#       128 にすると ratio-1 indexer 層の最初の decode で死ぬ。
# -----------------------------------------------------------------------------
VLLM_KV_ARGS=--kv-cache-memory-bytes 2684354560 --block-size 64

# -----------------------------------------------------------------------------
#   --quantization exl3     : EXL3 codebook mul1 / 平均 2.9bpw / head_bits=6 /
#                             mtp_bits=4。チェックポイント側に k_map が入っている
#                             (routed experts K3、layer18-22 だけ K2 など)。
#   --hf-overrides          : Engram テーブルの場所を教える。コンテナ内パス。
#                             空にするとネイティブ探索に行って起動しない。
#   --speculative-config    : チェックポイント内蔵 DSpark (mtp.*,
#                             dspark_block_size=5 / draft experts 128 top-3 /
#                             target layers 37-39)。DFlash のような別 drafter 不要。
#                             k の天井は 5 だが、実測では k=3 が最速だった
#                             (散文 k=3 28 tok/s / k=5 25 / なし 23)。
#                             ★4 ストリーム同時のようなバッチ運用なら
#                             SPEC なしの方が速い (集計 54 > k=3 の 42)。
#                             外すときはこの --speculative-config ごと削除。
#                             ~3.5GiB の空きが出る。
#   --prefix-cache-retention-interval 4096 : イメージ既定 (0) だと hybrid attention +
#                             DSpark で一部の prompt 長で再利用が全部飛ぶ。
#                             128 の倍数。ハイブリッドアテンションの
#                             latest-boundary-only への対策。
#   --cudagraph-capture-sizes 1 2 3 4 6 8 12 18 24 : ★これが無いと起動に落ちる。
#                             EXL3 ツリーは torch.compile 非対応で、指定なしだと
#                             cudagraph_mode=FULL_AND_PIECEWISE の解決に失敗する:
#                             "piecewise CUDA graphs unavailable, model is not
#                             torch-compiled and breakable CUDA graph is off"。
#                             上流 start.sh の shipped 既定をそのまま移植
#                             (k=5 → 6 tokens/step を含む 1〜4 並列カバー)。
#                             切り分けで無効化したいときは ENFORCE_EAGER=1。
# -----------------------------------------------------------------------------
VLLM_EXTRA_ARGS=--quantization exl3 --hf-overrides {"engram_table_dir":"/models/DeepSeek-V4.1-Flash-engram"} --speculative-config {"method":"dspark","num_speculative_tokens":3} --prefix-cache-retention-interval 4096 --cudagraph-capture-sizes 1 2 3 4 6 8 12 18 24

# -----------------------------------------------------------------------------
# EXL3 / DSV41 ランタイムノブ (すべてイメージ側の overlay が読む変数)
#
#   VLLM_DISABLE_SHARED_EXPERTS_STREAM=1 + DSV41_EXL3_SERIAL_STREAMS=1 は**必須**。
#   exllamav3 は device あたり lock buffer 1 個なので、違うストリームで EXL3 GEMM
#   を 2 つ走らせるとデッドロックする (上流 boot 11-14 の実測)。aux stream も止まる。
#
#   DSV41_IO_THREADS=96     : Engram のランダム行読み用スレッド。実測既定。
#                             ホストの CPU 圧を優先するなら 32。
#   DSV41_INDEXER_PREFILL_FACTOR=1 : indexer prefill gather の workspace 倍率。
#                             stock 40 だと 500K で 2.6GB。MAX_NUM_SEQS と同じで足りる。
#   DSV41_PREFILL_EMPTY_CACHE_TOKENS=8192 : この長さ以上の prefill チャンクの後に
#                             allocator cache を解放 (長時間プロンプトで host 予約が
#                             prompt^2 で増える対策)。0 で無効。
#   DSV41_DROP_PAGE_CACHE=1 : EXL3 shard を mmap で読み終わった後の page cache 捨て。
#                             GB10 ドライバは MemFree から取るため、これをやらないと
#                             MemAvailable 9GiB でも NVRM OOM した (boot 11 事故)。
#   EXL3_TEMP_ROWS_FUSED=16 : fused exl3_moe の行/expert 上限。超えた expert は
#                             E3 v2 grouped kernel (prefill)。MAX_NUM_SEQS x
#                             (DSpark k+1) 以上を保つと decode が 1 fused launch のまま。
#   GLM53_* はイメージ内 overlay が読む既存ノブ (recipe 既定値をそのまま)。
#   LANGUAGE_MODEL_ONLY / ENFORCE_EAGER / SKIP_MM_PROFILING / LIMIT_MM は
#   entrypoint が条件付きで `vllm serve` フラグに変換する。
#   vision 注意: SM120 の sparse-MLA prefill に 1152 幅 (SWA128+画像1024) の
#   カーネルが無いため、overlay が max_image_tokens=0 に pin する。画像は通るが
#   双方向可視性は入っていない (OCR/複数画像の体影響は計測で nil だった、との
#   上流報告。dense 文書タスクは自分で検証すること)。
# -----------------------------------------------------------------------------
VLLM_DISABLE_SHARED_EXPERTS_STREAM=1
DSV41_EXL3_SERIAL_STREAMS=1
DSV41_IO_THREADS=96
DSV41_INDEXER_PREFILL_FACTOR=1
DSV41_PREFILL_EMPTY_CACHE_TOKENS=8192
DSV41_PREFILL_EMPTY_CACHE_MEMAVAIL_GIB=2.5
DSV41_DROP_PAGE_CACHE=1
DSV41_BOOT_SHAPE_WARMUP=1
DSV41_SKIP_MIXED_WARMUP=0
DSV41_PREFILL_END_EMPTY_CACHE=0
EXL3_FUSED_MOE=1
EXL3_FAT_KERNEL=0
EXL3_FAT_GROUPED=1
EXL3_TEMP_ROWS_FUSED=16
GLM53_SUPPRESS_STOPS_IN_REASONING=1
GLM53_MIXED_PREFILL_CHUNK=0
GLM53_SPINWAIT_MS=stock

LANGUAGE_MODEL_ONLY=0
ENFORCE_EAGER=0
SKIP_MM_PROFILING=1
LIMIT_MM={"image":100}

# -----------------------------------------------------------------------------
# SM121 / NCCL / ランタイム基盤
#   VLLM_NCCL_SO_PATH は空のまま (USE_HOST_NCCL=0 相当)。イメージ内 torch 同梱の
#   NCCL を使う。apt 版を向いていた Vision-Exp までとは違う。空文字は entrypoint
#   が unset する。
#   NCCL_BUFFSIZE / LL128 / PROTO / MAX_NCHANNELS は UMA 向けの調整
#   (ネイティブ DS4.1 3-Spark recipe 由来。NCCL_PROTO は ^LL128 = LL128 以外を使う)。
#   PYTORCH expandable_segments:True は long prefill の断片化対策 (455K で 244 tok/s
#   への劣化が解消)。SGLang 側では NaN 報告があるが vLLM スタックでは clean (2026-09-13)。
# -----------------------------------------------------------------------------
FLASHINFER_CUDA_ARCH_LIST=12.1a
TORCH_CUDA_ARCH_LIST=12.1a
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True
VLLM_NCCL_SO_PATH=
VLLM_LD_LIBRARY_PATH_EXTRA=/usr/local/cuda/lib64:/usr/local/nvidia/lib64
VLLM_SPARSE_INDEXER_MAX_LOGITS_MB=256

NCCL_IB_DISABLE=0
NCCL_NVLS_ENABLE=0
NCCL_IGNORE_CPU_AFFINITY=1
NCCL_BUFFSIZE=1048576
NCCL_LL128_BUFFSIZE=262144
NCCL_PROTO=^LL128
NCCL_MAX_NCHANNELS=8
# ハンドシェイクを追う時は INFO に上げる
NCCL_DEBUG=WARN
MAX_JOBS=4
