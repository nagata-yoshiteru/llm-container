 #include "compiler.h"
 #include <assert.h>
 #include "register_inline.h"
+
+// GB10: cudaHostAlloc-backed NET buffers can fail ibv_reg_mr_iova2 with
+// ENOMEM even before model loading. Use page-aligned ordinary host memory
+// registered with CUDA. Keep the allocation/free pairing local to NET buffers.
+NCCL_PARAM(NetHostRegister, "NET_HOST_REGISTER", 0);
+
+static ncclResult_t ncclNetHostCalloc(char** ptr, size_t size) {
+  if (!ncclParamNetHostRegister()) return ncclCudaHostCalloc(ptr, size);
+  *ptr = nullptr;
+  if (size == 0) return ncclSuccess;
+  ncclResult_t result = ncclSuccess;
+  cudaStreamCaptureMode mode = cudaStreamCaptureModeRelaxed;
+  void* devicePtr = nullptr;
+  CUDACHECK(cudaThreadExchangeStreamCaptureMode(&mode));
+  NCCLCHECKGOTO(ncclIbMalloc((void**)ptr, size), result, finish);
+  CUDACHECKGOTO(cudaHostRegister(*ptr, size, cudaHostRegisterMapped), result, free_host);
+  CUDACHECKGOTO(cudaHostGetDevicePointer(&devicePtr, *ptr, 0), result, unregister_host);
+  // NET's connectMap uses the same address on CPU and GPU. Refuse devices
+  // without that UVA property instead of publishing an invalid GPU pointer.
+  if (devicePtr != *ptr) {
+    WARN("NET_HOST_REGISTER requires identical CPU/GPU host-buffer addresses");
+    result = ncclInternalError;
+    goto unregister_host;
+  }
+  INFO(NCCL_ALLOC, "NET_HOST_REGISTER allocated %zu bytes at %p", size, *ptr);
+  goto finish;
+unregister_host:
+  if (cudaHostUnregister(*ptr) != cudaSuccess) {
+    WARN("NET_HOST_REGISTER cleanup could not unregister host storage");
+    goto finish;
+  }
+free_host:
+  free(*ptr);
+  *ptr = nullptr;
+finish:
+  CUDACHECK(cudaThreadExchangeStreamCaptureMode(&mode));
+  return result;
+}
+
+static ncclResult_t ncclNetHostFree(void* ptr) {
+  if (!ncclParamNetHostRegister()) return ncclCudaHostFree(ptr);
+  if (ptr == nullptr) return ncclSuccess;
+  cudaStreamCaptureMode mode = cudaStreamCaptureModeRelaxed;
+  CUDACHECK(cudaThreadExchangeStreamCaptureMode(&mode));
+  cudaError_t status = cudaHostUnregister(ptr);
+  // Do not free storage still registered with CUDA if unregistering failed.
+  if (status == cudaSuccess) free(ptr);
+  CUDACHECK(cudaThreadExchangeStreamCaptureMode(&mode));
+  CUDACHECK(status);
+  return ncclSuccess;
+}
 
